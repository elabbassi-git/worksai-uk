# Generated by integrations/seo-build.ts on build. Edit that file, not this one.
Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddCharset utf-8 .txt .xml .html .css .js .json .svg
AddType application/rss+xml .rss

<FilesMatch "^(_headers|_redirects)$">
  Require all denied
</FilesMatch>

RewriteEngine On

# One canonical origin: https://worksai.uk (ACME challenges left alone for AutoSSL)
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^worksai\.uk$ [NC]
RewriteRule ^ https://worksai.uk%{REQUEST_URI} [R=301,L]

# Directories always end with a slash (Astro trailingSlash: 'always')
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^(.+[^/])$ https://worksai.uk/$1/ [R=301,L]

RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

RewriteRule ^home/?$ / [R=301,L]
RewriteRule ^services/whatsapp-chatbot/?$ /services/ai-agents/whatsapp/ [R=301,L]
RewriteRule ^services/ai-receptionist/?$ /services/ai-agents/ai-receptionist/ [R=301,L]
RewriteRule ^website-design/?$ /business/website-design-seo/ [R=301,L]
RewriteRule ^courses/?$ /ai-shop/training/ [R=301,L]
RewriteRule ^courses/(.*)$ /ai-shop/training/$1 [R=301,L]
RewriteRule ^subscriptions/?$ /pricing/ [R=301,L]
RewriteRule ^ai-shop/subscriptions/?$ /pricing/ [R=301,L]
RewriteRule ^audit/?$ /free-ai-audit/ [R=301,L]
RewriteRule ^seo-check/?$ /free-seo-check/ [R=301,L]
RewriteRule ^feed/?$ /rss.xml [R=301,L]
RewriteRule ^services/dashboards-saas/?$ /services/saas-development/ [R=301,L]

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src 'none'; form-action 'self' https://wa.me; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
