---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { publishedCourses } from '@/lib/content';
import { courses as coursePrices, formatGBP } from '@/data/pricing';
import { article } from '@/lib/schema';
import { site } from '@/config/site';

interface Props {
  entry: CollectionEntry<'lessons'>;
}
const { entry } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const course = (await publishedCourses()).find((c) => c.id === d.course);
if (!course) throw new Error(`Lesson ${entry.id} points to a missing or draft course`);
const toc = headings.filter((h) => h.depth === 2);
const schema = [article({ headline: d.h1, description: d.description, path: d.path, published: d.updated, updated: d.updated, author: site.brand })];
---

<BaseLayout
  title={d.title}
  description={d.description}
  path={d.path}
  ogType="article"
  breadcrumbs={[{ name: 'AI Shop', path: '/ai-shop/' }, { name: 'Training & Coaching', path: '/ai-shop/training/' }, { name: course.data.name, path: course.data.path }, { name: 'Free lesson', path: d.path }]}
  schema={schema}
  updated={d.updated}
>
  <div class="read-progress" aria-hidden="true"></div>
  <div class="container-x grid gap-12 pb-20 pt-10 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
    <article>
      <p class="eyebrow">Free lesson · {d.duration} read · from “{course.data.name}”</p>
      <h1 class="mt-5 text-h1">{d.h1}</h1>
      {
        toc.length > 2 && (
          <nav aria-label="In this lesson" class="mt-8 rounded-2xl border border-line bg-card p-5">
            <p class="eyebrow">In this lesson</p>
            <ol class="mt-3 grid list-decimal gap-1.5 pl-5 text-ink-2">{toc.map((h) => <li><a class="hover:text-ink hover:underline" href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )
      }
      <div class="prose prose-lg prose-works mt-10 max-w-3xl"><Content /></div>
    </article>
    <aside class="lg:pt-24">
      <div class="card p-6 lg:sticky lg:top-24">
        <p class="eyebrow">Full course</p>
        <p class="mt-3 font-display text-xl font-semibold leading-snug">{course.data.name}</p>
        <p class="mt-2 text-ink-2">{course.data.format} · {course.data.length}</p>
        <p class="mt-4 font-display text-3xl font-semibold">{formatGBP(coursePrices[course.id]!.price)}</p>
        <a href={course.data.path} class="btn btn-primary mt-5 w-full">See the full course</a>
        <a href={course.data.service} class="link mt-4 block text-sm font-semibold">Or have Works AI set it up for you</a>
      </div>
    </aside>
  </div>
</BaseLayout>
