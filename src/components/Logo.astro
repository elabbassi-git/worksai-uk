---
/**
 * Works AI logo.
 * - animated (header): the wordmark writes itself like a signature (stroke draw → fill →
 *   flourish → hold → erase → loop). Fixed SVG box = zero layout shift. Starts mid-cycle
 *   (negative delay) so the logo is fully visible on first paint. Static for reduced motion.
 * - static (footer, etc.): plain wordmark.
 */
interface Props {
  dark?: boolean;
  animated?: boolean;
}
const { dark = false, animated = false } = Astro.props;
---

<span class="inline-flex items-center">
  {
    animated ? (
      <svg class:list={['signature h-auto w-[104px] min-[360px]:w-[124px]', dark && 'is-dark']} width="124" height="36" viewBox="0 0 112 34" aria-hidden="true">
        <text x="0" y="23" class="sig-text">
          <tspan>Works</tspan>
          <tspan dx="5" class="sig-accent">
            AI
          </tspan>
        </text>
        <path class="sig-swoosh" pathLength="1" d="M70 29.5 C 80 31.5, 92 31, 106 27.5 C 109 26.7, 110 25.6, 108.5 25" />
      </svg>
    ) : (
      <span class:list={['font-display text-[1.5rem] font-semibold tracking-tight', dark ? 'text-paper' : 'text-ink']}>
        Works<span class={dark ? 'text-signal' : 'text-signal-deep'}>&nbsp;AI</span>
      </span>
    )
  }
</span>

<style>
  .signature {
    overflow: visible;
    color: var(--color-ink);
  }
  .sig-text {
    font-family: var(--font-display);
    font-size: 23px;
    font-weight: 650;
    letter-spacing: -0.03em;
    fill: currentColor;
    stroke: currentColor;
    stroke-width: 0.55;
    stroke-linejoin: round;
    stroke-dasharray: 120;
    stroke-dashoffset: 0;
  }
  .sig-accent {
    fill: var(--color-signal-deep);
    stroke: var(--color-signal-deep);
  }
  .signature.is-dark {
    color: var(--color-paper);
  }
  .signature.is-dark .sig-accent {
    fill: var(--color-signal);
    stroke: var(--color-signal);
  }
  .sig-swoosh {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .sig-text {
      animation: sig-write 10s cubic-bezier(0.55, 0.1, 0.3, 1) -4.6s infinite;
      will-change: stroke-dashoffset, fill-opacity, opacity;
    }
    .sig-swoosh {
      animation: sig-swoosh 10s cubic-bezier(0.6, 0, 0.3, 1) -4.6s infinite;
      will-change: stroke-dashoffset, opacity;
    }
    a:hover .sig-swoosh {
      stroke: var(--color-signal-deep);
    }
  }
  @keyframes sig-write {
    0% {
      stroke-dashoffset: 120;
      fill-opacity: 0;
      opacity: 1;
    }
    28% {
      stroke-dashoffset: 0;
      fill-opacity: 0;
    }
    40% {
      stroke-dashoffset: 0;
      fill-opacity: 1;
    }
    84% {
      stroke-dashoffset: 0;
      fill-opacity: 1;
      opacity: 1;
    }
    93% {
      opacity: 0;
      fill-opacity: 1;
      stroke-dashoffset: 0;
    }
    94% {
      opacity: 0;
      fill-opacity: 0;
      stroke-dashoffset: 120;
    }
    100% {
      opacity: 1;
      fill-opacity: 0;
      stroke-dashoffset: 120;
    }
  }
  @keyframes sig-swoosh {
    0%,
    36% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    46% {
      stroke-dashoffset: 0;
    }
    84% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    93%,
    100% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
  }
</style>
