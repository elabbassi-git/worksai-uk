---
import { site, isSet } from '@/config/site';
const ready = isSet(site.bookingUrl);
---

<div class="card overflow-hidden" data-booking data-src={ready ? site.bookingUrl : ''}>
  <div class="grid place-items-center gap-5 px-6 py-14 text-center" data-booking-placeholder>
    <div class="grid size-16 place-items-center rounded-2xl bg-signal-soft text-signal-deep" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3 10h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7"/></svg>
    </div>
    <div>
      <h3 class="font-display text-h3 font-semibold">Pick a time that suits you</h3>
      <p class="mx-auto mt-2 max-w-md text-ink-2">The calendar loads when you click, so this page stays fast. Times are shown in UK time.</p>
    </div>
    <button type="button" class="btn btn-primary" data-booking-load data-event="audit_booking_click" data-event-label="calendar_open">Book my free audit</button>
    <p class="hidden text-sm text-ink-3" data-booking-missing>Online booking is not connected yet. Please use the form below and we will send you times.</p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-booking]').forEach((root) => {
    root.querySelector('[data-booking-load]')?.addEventListener('click', () => {
      const src = root.dataset.src;
      if (!src) {
        root.querySelector('[data-booking-missing]')?.classList.remove('hidden');
        return;
      }
      const iframe = document.createElement('iframe');
      iframe.src = src;
      iframe.title = 'Book a free 30-minute AI audit';
      iframe.loading = 'lazy';
      iframe.className = 'block h-[720px] w-full border-0';
      root.replaceChildren(iframe);
    });
  });
</script>
