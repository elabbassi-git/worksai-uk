---
import { site } from '@/config/site';
import { isPublished, publishedServices } from '@/lib/content';
import { budgetBands } from '@/data/pricing';

interface Props {
  variant: 'contact' | 'seo-check' | 'audit';
  id?: string;
  submitLabel?: string;
  /** Contact page layout: preferred call time, business type, service and budget. */
  rich?: boolean;
}
const { variant, id = `form-${variant}`, submitLabel, rich = false } = Astro.props;
const serviceOptions = rich ? (await publishedServices()).map((s) => s.data.navLabel) : [];
const businessTypes = ['Trades & home services', 'Health & clinics', 'Professional services', 'Retail & e-commerce', 'Hospitality', 'Property', 'Startup / SaaS', 'Agency', 'Other'];
const times = ['09:00', '10:30', '12:00', '14:00', '15:30', '17:00'];
const privacyLive = await isPublished('/privacy/');
const event = { contact: 'contact_submit', 'seo-check': 'seo_check_submit', audit: 'contact_submit' }[variant];
const label = submitLabel ?? { contact: 'Send message', 'seo-check': 'Request my free check', audit: 'Send my details' }[variant];
---

<div class:list={['lead-form card p-6 sm:p-8', rich && 'is-rich']} data-lead-form data-variant={variant} data-event-name={event}>
  <form id={id} action={site.formEndpoint} method="POST" novalidate class="grid gap-5">
    <input type="hidden" name="form" value={variant} />
    <input type="hidden" name="page" value="" data-page-field />
    <!-- Honeypot: humans never see or fill this -->
    <div class="hidden" aria-hidden="true">
      <label>Leave this empty <input type="text" name="company_website" tabindex="-1" autocomplete="off" /></label>
    </div>

    {
      rich && (
        <fieldset class="rounded-2xl bg-paper/80 p-4 ring-1 ring-line">
          <legend class="sr-only">Preferred time for a call</legend>
          <p class="flex items-center gap-2 text-sm font-semibold" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24"><path d="M4 7h16v13H4zM8 3v4M16 3v4M4 11h16" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
            Preferred time for a call <span class="font-normal text-ink-3">(UK time, today or next working day)</span>
          </p>
          <div class="mt-3 grid grid-cols-3 gap-2 sm:grid-cols-6">
            {times.map((t, i) => (
              <label class="slot-chip">
                <input type="radio" name="preferred_time" value={t} class="sr-only" checked={i === 0} />
                <span>{t}</span>
              </label>
            ))}
          </div>
        </fieldset>
      )
    }

    {
      variant === 'seo-check' && (
        <fieldset class="grid gap-3">
          <legend class="label">Your website</legend>
          <div>
            <label for={`${id}-url`} class="sr-only">
              Website address
            </label>
            <input id={`${id}-url`} name="website" type="url" inputmode="url" autocomplete="url" placeholder="https://www.yourbusiness.co.uk" required class="field" aria-describedby={`${id}-url-error`} />
            <p id={`${id}-url-error`} class="mt-1.5 hidden text-sm text-[#b3261e]" data-error>
              Enter your full website address, starting with https://
            </p>
          </div>
          <label class="flex items-center gap-3 text-ink-2">
            <input type="checkbox" name="no_website" value="yes" class="size-5 accent-ink" data-no-website />
            I don't have a website yet
          </label>
        </fieldset>
      )
    }

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for={`${id}-name`} class="label">Your name</label>
        <input id={`${id}-name`} name="name" type="text" autocomplete="name" required class="field" aria-describedby={`${id}-name-error`} />
        <p id={`${id}-name-error`} class="mt-1.5 hidden text-sm text-[#b3261e]" data-error>Please tell us your name.</p>
      </div>
      <div>
        <label for={`${id}-email`} class="label">{variant === 'contact' ? 'Email' : 'Business email'}</label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" required class="field" aria-describedby={`${id}-email-error`} />
        <p id={`${id}-email-error`} class="mt-1.5 hidden text-sm text-[#b3261e]" data-error>Enter an email address we can reply to.</p>
      </div>
    </div>

    {
      rich && (
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${id}-type`} class="label">Type of business</label>
            <select id={`${id}-type`} name="business_type" class="field">
              <option value="">Select…</option>
              {businessTypes.map((b) => <option>{b}</option>)}
            </select>
          </div>
          <div>
            <label for={`${id}-phone`} class="label">
              Phone or WhatsApp <span class="font-normal text-ink-3">(optional)</span>
            </label>
            <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" class="field" />
          </div>
          <div>
            <label for={`${id}-service`} class="label">Service you're interested in</label>
            <select id={`${id}-service`} name="service" class="field">
              <option value="">Select…</option>
              {serviceOptions.map((o) => <option>{o}</option>)}
              <option>Not sure yet</option>
            </select>
          </div>
          <div>
            <label for={`${id}-budget`} class="label">Estimated budget <span class="font-normal text-ink-3">(one-time)</span></label>
            <select id={`${id}-budget`} name="budget" class="field">
              <option value="">Select…</option>
              {budgetBands.map((b) => <option>{b}</option>)}
            </select>
          </div>
        </div>
      )
    }

    {
      variant !== 'seo-check' && !rich && (
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for={`${id}-business`} class="label">
              Business name <span class="font-normal text-ink-3">(optional)</span>
            </label>
            <input id={`${id}-business`} name="business" type="text" autocomplete="organization" class="field" />
          </div>
          <div>
            <label for={`${id}-phone`} class="label">
              Phone <span class="font-normal text-ink-3">(optional)</span>
            </label>
            <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" class="field" />
          </div>
        </div>
      )
    }

    <div>
      <label for={`${id}-message`} class="label">
        {variant === 'audit' ? 'What would you like help with?' : rich ? 'Your message' : 'Message'}
        {rich && <span class="font-normal text-ink-3"> (optional)</span>}
        {variant === 'seo-check' && <span class="font-normal text-ink-3"> (optional)</span>}
      </label>
      <textarea id={`${id}-message`} name="message" rows="4" class="field" required={variant === 'contact' && !rich} aria-describedby={`${id}-message-error`}></textarea>
      <p id={`${id}-message-error`} class="mt-1.5 hidden text-sm text-[#b3261e]" data-error>Please add a short message.</p>
    </div>

    <label class="flex items-start gap-3 text-sm text-ink-2">
      <input type="checkbox" name="marketing_opt_in" value="yes" class="mt-0.5 size-5 shrink-0 accent-ink" />
      <span>Optional: send me occasional emails with practical AI and website tips. You can unsubscribe at any time.</span>
    </label>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <button type="submit" class="btn btn-primary" data-submit>{label}</button>
      <p class="text-sm text-ink-3 sm:max-w-xs" data-promise>
        {variant === 'seo-check' ? 'We will email you a short report within 2 working days.' : 'We reply within one working day, in UK hours.'}
      </p>
    </div>

    <p class="text-sm text-ink-3">
      We use your details only to reply to this request. We never sell them.
      {
        privacyLive && (
          <>
            Read our{' '}
            <a href="/privacy/" class="link">
              privacy notice
            </a>
            .
          </>
        )
      }
    </p>
    <p role="alert" class="hidden rounded-xl bg-[#fde8e6] p-4 text-[#7a1c14]" data-form-error></p>
  </form>

  <div hidden tabindex="-1" data-success role="status" class="py-6 text-center">
    <div class="mx-auto grid size-14 place-items-center rounded-full bg-moss-soft text-moss" aria-hidden="true">
      <svg width="26" height="26" viewBox="0 0 16 16"><path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
    </div>
    <p class="mt-5 font-display text-h3 font-semibold">Thank you, we have your request.</p>
    <p class="mx-auto mt-3 max-w-md text-ink-2" data-success-text>
      {
        variant === 'seo-check'
          ? 'We will look at your website ourselves and email you a short report within 2 working days.'
          : 'We will reply within one working day, in UK business hours.'
      }
    </p>
  </div>
</div>

<style>
  .slot-chip {
    display: block;
    cursor: pointer;
  }
  .slot-chip span {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    border-radius: 0.8rem;
    background: var(--color-card);
    box-shadow: inset 0 0 0 1.5px var(--color-line-strong);
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background-color 0.15s,
      color 0.15s,
      box-shadow 0.15s;
  }
  .slot-chip:hover span {
    box-shadow: inset 0 0 0 1.5px var(--color-ink);
  }
  .slot-chip input:checked + span {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
  .slot-chip input:focus-visible + span {
    outline: 3px solid var(--color-signal-deep);
    outline-offset: 2px;
  }
</style>

<script>
  import { initLeadForms } from '@/lib/forms';
  initLeadForms();
</script>
