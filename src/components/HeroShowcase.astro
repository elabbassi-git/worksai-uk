---
/**
 * Homepage hero showcase: 4 auto-rotating, coded UI slides (no images), looping forever.
 * - Every slide is laid out at 640 px and scaled with container queries inside a stage of
 *   fixed aspect ratio, so there is never any layout shift.
 * - Each slide plays a live, step-by-step sequence while active (restarts on each visit).
 * - Pill indicators jump to a slide; auto-advance continues afterwards.
 * - Emits `showcase:change` (detail: { index }) so the hero copy stays in sync.
 * - Rotation idles only while off-screen or in a background tab (saves battery).
 * All data shown is illustrative demo data.
 */
import PlatformMockup from './PlatformMockup.astro';

const slides = [
  { id: 'saas', tab: 'SaaS platforms', title: 'SaaS platform development' },
  { id: 'web', tab: 'Websites', title: 'Professional web development' },
  { id: 'auto', tab: 'AI automation', title: 'AI & workflow automation' },
  { id: 'seo', tab: 'SEO', title: 'SEO & search growth' },
];
const traffic = [12, 14, 13, 18, 21, 20, 26, 31, 30, 38, 44, 52];
const maxT = Math.max(...traffic);
const pts = traffic.map((v, i) => `${(i / (traffic.length - 1)) * 300},${100 - (v / maxT) * 88}`).join(' ');

/* Automation canvas: 600 × 264 px, matching the node grid 1:1 so pulses follow the wires exactly. */
const wires = {
  t1: 'M144 59 C 200 59, 190 132, 240 132',
  t2: 'M144 205 C 200 205, 190 132, 240 132',
  a1: 'M372 132 C 420 132, 410 46, 456 46',
  a2: 'M372 132 L 456 132',
  a3: 'M372 132 C 420 132, 410 218, 456 218',
};
const actions = [
  { top: 46, name: 'Calendar', done: 'Booked Thu 10:00 ✓', i: 0 },
  { top: 132, name: 'WhatsApp', done: 'Confirmation sent ✓', i: 1 },
  { top: 218, name: 'CRM', done: 'Contact synced ✓', i: 2 },
];
---

<section class="showcase relative mx-auto w-full max-w-[40rem]" aria-roledescription="carousel" aria-label="What Works AI builds" data-showcase>
  <div class="stage relative" data-stage>
    <!-- 1. SaaS -->
    <div class="slide is-active" id="slide-saas" role="group" aria-roledescription="slide" aria-label="1 of 4: SaaS platform development" data-slide>
      <PlatformMockup />
    </div>

    <!-- 2. Web development -->
    <div class="slide" id="slide-web" role="group" aria-roledescription="slide" aria-label="2 of 4: Professional web development" aria-hidden="true" inert data-slide>
      <div class="relative" aria-hidden="true">
        <div class="window overflow-hidden rounded-[1.4rem] border border-ink/10 bg-card shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
          <div class="flex items-center gap-3 border-b border-line bg-paper px-4 py-3">
            <span class="flex gap-1.5"><i class="size-2.5 rounded-full bg-[#f87171]"></i><i class="size-2.5 rounded-full bg-[#fbbf24]"></i><i class="size-2.5 rounded-full bg-[#4ade80]"></i></span>
            <span class="mx-auto flex items-center gap-2 rounded-lg bg-card px-3 py-1 font-mono text-[0.68rem] text-ink-3 ring-1 ring-line">examplekitchens.co.uk</span>
          </div>
          <div class="load-line h-0.5 bg-signal"></div>
          <div class="p-5 text-[0.72rem]">
            <div class="w-in flex items-center justify-between" style="--i:0">
              <span class="font-display text-sm font-semibold">Example Kitchens</span>
              <span class="flex gap-3 text-ink-3"><span>Kitchens</span><span>Gallery</span><span>Prices</span></span>
              <span class="rounded-full bg-ink px-2.5 py-1 font-semibold text-paper">Free quote</span>
            </div>
            <div class="mt-5 grid grid-cols-[1.3fr_1fr] items-center gap-4">
              <div>
                <p class="w-in font-display text-[1.6rem] font-semibold leading-[1.05]" style="--i:1">Kitchens fitted in 10 days, in Leeds</p>
                <p class="w-in mt-2 text-ink-3" style="--i:2">Fixed quote after a free home visit. 2-year guarantee.</p>
                <div class="w-in mt-3 flex gap-2" style="--i:3">
                  <span class="cta rounded-full bg-signal px-3 py-1.5 font-semibold text-ink">Book a visit</span>
                  <span class="rounded-full px-3 py-1.5 font-semibold ring-1 ring-ink/40">See prices</span>
                </div>
              </div>
              <div class="w-in hero-img aspect-[4/3] rounded-xl" style="--i:2"></div>
            </div>
            <div class="mt-5 grid grid-cols-3 gap-2">
              {['Kitchen design', 'Fitting', 'Worktops'].map((t, i) => (
                <div class="w-in rounded-xl bg-paper p-2.5 ring-1 ring-line" style={`--i:${i + 4}`}>
                  <span class="block size-5 rounded-md bg-signal-soft" />
                  <p class="mt-2 font-semibold">{t}</p>
                  <p class="text-ink-3">From a fixed price</p>
                </div>
              ))}
            </div>
            <div class="chat-pop mt-3 flex items-center gap-2 rounded-xl bg-moss-soft/70 p-2.5 text-moss">
              <span class="size-2 rounded-full bg-moss"></span>
              <span class="font-semibold">AI chat: “Do you cover LS6?” · answered in 2 s</span>
            </div>
          </div>
        </div>
        <div class="float-a absolute -right-8 -top-7 w-[13rem] rounded-2xl bg-card p-3 shadow-[var(--shadow-lift)] ring-1 ring-line">
          <div class="flex items-center gap-3">
            <span class="gauge relative grid size-12 place-items-center rounded-full text-[0.85rem] font-bold text-moss"><span class="score"></span></span>
            <span class="text-[0.72rem] leading-tight"><b class="block text-ink">Performance</b><span class="text-ink-3">Demo audit</span></span>
          </div>
          <div class="mt-2.5 text-[0.66rem]">
            <div class="flex justify-between text-ink-3">
              <span>Load time (LCP)</span>
              <span class="lcp relative grid font-semibold"><span class="lcp-slow text-[#b3261e]">3.8 s</span><span class="lcp-fast text-moss">1.2 s</span></span>
            </div>
            <div class="mt-1 grid grid-cols-3 gap-1">
              <span class="m m1 h-1.5 rounded-full"></span><span class="m m2 h-1.5 rounded-full"></span><span class="m m3 h-1.5 rounded-full"></span>
            </div>
          </div>
        </div>
        <div class="float-b absolute -bottom-9 -left-10 h-[11.5rem] w-[7.5rem] overflow-hidden rounded-[1.3rem] bg-night p-1.5 shadow-[0_30px_60px_-25px_rgb(21_23_28/0.7)]">
          <div class="h-full overflow-hidden rounded-[1rem] bg-card">
            <div class="phone-scroll p-2 text-[0.55rem]">
              <p class="font-display text-[0.75rem] font-semibold leading-tight">Kitchens fitted in 10 days</p>
              <span class="mt-1.5 block rounded-full bg-signal px-2 py-1 text-center font-semibold text-ink">Book a visit</span>
              <span class="mt-1.5 block h-12 rounded-md bg-paper-2"></span>
              {['Kitchen design', 'Fitting', 'Worktops', 'Reviews ★★★★★'].map((t) => (
                <span class="mt-1.5 block rounded-md bg-paper px-1.5 py-1.5 ring-1 ring-line">{t}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. AI & workflow automation -->
    <div class="slide" id="slide-auto" role="group" aria-roledescription="slide" aria-label="3 of 4: AI and workflow automation" aria-hidden="true" inert data-slide>
      <div class="relative overflow-hidden rounded-[1.4rem] bg-night p-5 text-paper shadow-[0_60px_120px_-50px_rgb(21_23_28/0.7)]" aria-hidden="true">
        <div class="flex items-center justify-between text-[0.7rem]">
          <span class="font-display text-sm font-semibold">Workflow · New enquiry</span>
          <span class="flex items-center gap-2 rounded-full bg-paper/10 px-2.5 py-1"><i class="blink size-2 rounded-full bg-[#4ade80]"></i>Running · demo</span>
        </div>
        <div class="relative mt-4 h-[264px] w-[600px] text-[0.7rem]">
          <svg class="absolute inset-0" width="600" height="264" viewBox="0 0 600 264">
            {Object.entries(wires).map(([, d]) => <path class="wire" d={d} />)}
          </svg>
          {Object.entries(wires).map(([k, d]) => <span class={`pulse pulse-${k}`} style={`offset-path: path('${d}')`} />)}

          <div class="anode trig trig-1 absolute left-0 top-[59px] w-[144px] -translate-y-1/2 rounded-xl bg-paper/10 p-2 ring-1 ring-paper/15">
            <p class="text-[0.58rem] uppercase tracking-wider opacity-70">Trigger</p>
            <p class="font-semibold leading-tight">New lead form</p>
            <p class="opacity-80">21:14 · /quote</p>
          </div>
          <div class="anode trig trig-2 absolute left-0 top-[205px] w-[144px] -translate-y-1/2 rounded-xl bg-paper/10 p-2 ring-1 ring-paper/15">
            <p class="text-[0.58rem] uppercase tracking-wider opacity-70">Trigger</p>
            <p class="font-semibold leading-tight">Incoming call</p>
            <p class="opacity-80">Ringing…</p>
          </div>
          <div class="anode ai absolute left-[240px] top-[132px] w-[132px] -translate-y-1/2 rounded-xl bg-signal p-2 text-ink">
            <p class="text-[0.58rem] uppercase tracking-wider opacity-70">AI</p>
            <p class="font-semibold leading-tight">AI qualification</p>
            <p class="flip relative grid">
              <span class="s-wait">Qualifying…</span>
              <span class="s-done font-semibold">Score 8/10 ✓</span>
            </p>
          </div>
          {actions.map((a) => (
            <div class={`anode act act-${a.i} absolute left-[456px] w-[144px] -translate-y-1/2 rounded-xl bg-paper/10 p-2 ring-1 ring-paper/15`} style={`top:${a.top}px`}>
              <p class="text-[0.58rem] uppercase tracking-wider opacity-70">Action</p>
              <p class="font-semibold leading-tight">{a.name}</p>
              <p class="flip relative grid">
                <span class="s-wait opacity-70">Waiting…</span>
                <span class="s-done font-semibold text-[#86efac]">{a.done}</span>
              </p>
            </div>
          ))}
        </div>
        <div class="mt-3 grid gap-1.5 font-mono text-[0.62rem] text-paper/70">
          <p class="log" style="--t:0.6s">21:14:02 · lead received · form /quote</p>
          <p class="log" style="--t:2.4s">21:14:04 · AI qualified · score 8/10</p>
          <p class="log" style="--t:4s">21:14:05 · booked · WhatsApp sent · CRM synced ✓</p>
        </div>
      </div>
    </div>

    <!-- 4. SEO -->
    <div class="slide" id="slide-seo" role="group" aria-roledescription="slide" aria-label="4 of 4: SEO and search growth" aria-hidden="true" inert data-slide>
      <div class="relative" aria-hidden="true">
        <div class="overflow-hidden rounded-[1.4rem] border border-ink/10 bg-card p-5 shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
          <div class="flex items-center gap-2 rounded-full bg-paper px-3 py-2 text-[0.75rem] ring-1 ring-line">
            <svg width="14" height="14" viewBox="0 0 24 24" class="text-ink-3"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm10 3-5-5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
            <span class="typed">kitchen fitter leeds</span><span class="caret"></span>
          </div>
          <div class="relative mt-3 h-[8.6rem]">
            <div class="res res-them absolute inset-x-0 rounded-xl bg-paper/70 p-3 ring-1 ring-line">
              <div class="flex items-start gap-3">
                <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-paper-2 font-display text-sm font-bold text-ink-3">#2</span>
                <div class="min-w-0 text-[0.72rem]">
                  <p class="truncate text-ink-3">example-directory.co.uk › kitchens</p>
                  <p class="font-display text-[0.9rem] font-semibold leading-snug text-[#1a4fb4]">Kitchen Fitters Near You | Compare Quotes</p>
                </div>
              </div>
            </div>
            <div class="res res-us absolute inset-x-0 rounded-xl bg-card p-3 shadow-[var(--shadow-card)] ring-1 ring-signal/50">
              <div class="flex items-start gap-3">
                <span class="rank grid size-9 shrink-0 place-items-center rounded-xl bg-signal font-display text-sm font-bold text-ink"></span>
                <div class="min-w-0 text-[0.72rem]">
                  <p class="truncate text-ink-3">examplekitchens.co.uk › kitchens-leeds</p>
                  <p class="font-display text-[0.9rem] font-semibold leading-snug text-[#1a4fb4]">Kitchen Fitters in Leeds | Fitted in 10 Days</p>
                  <p class="text-ink-3">Fixed quote after a free home visit. ★★★★★ reviews.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-3 rounded-xl bg-paper p-3 ring-1 ring-line">
            <div class="flex items-center justify-between text-[0.7rem]">
              <span class="font-semibold">Organic clicks, last 12 weeks</span>
              <span class="rounded-full bg-moss-soft px-2 py-0.5 font-semibold text-moss"><span class="clicks"></span> this week</span>
            </div>
            <svg viewBox="0 0 300 100" class="mt-2 h-20 w-full" preserveAspectRatio="none">
              <defs>
                <linearGradient id="seo-fill" x1="0" x2="0" y1="0" y2="1"><stop offset="0" stop-color="#ec5b2a" stop-opacity=".28"></stop><stop offset="1" stop-color="#ec5b2a" stop-opacity="0"></stop></linearGradient>
              </defs>
              <polygon class="area" points={`0,100 ${pts} 300,100`} fill="url(#seo-fill)"></polygon>
              <polyline class="line" points={pts} fill="none" stroke="#a83a12" stroke-width="2.5" vector-effect="non-scaling-stroke" pathLength="1"></polyline>
            </svg>
          </div>
          <div class="mt-3 flex flex-wrap gap-2 text-[0.68rem]">
            {
              [
                ['kitchen fitter leeds', 'k1'],
                ['fitted kitchens leeds', 'k2'],
                ['kitchen installation ls6', 'k3'],
              ].map(([k, c]) => (
                <span class="kw flex items-center gap-1.5 rounded-full bg-paper px-2.5 py-1 ring-1 ring-line">
                  <b class={`pos ${c} text-ink`} />
                  {k}
                  <span class="font-semibold text-moss">↑</span>
                </span>
              ))
            }
          </div>
        </div>
        <div class="float-a absolute -right-8 -top-7 rounded-2xl bg-card px-3.5 py-2.5 text-[0.72rem] shadow-[var(--shadow-lift)] ring-1 ring-line">
          <p class="font-semibold text-moss">Google Business Profile ✓</p>
          <p class="text-ink-3">Shown in the local map pack</p>
        </div>
      </div>
    </div>
  </div>

  <!-- indicators (no pause control: the showcase loops continuously) -->
  <div class="mt-12 flex flex-wrap items-center justify-center gap-2" data-controls>
    {
      slides.map((s, i) => (
        <button type="button" class="pill" data-go={i} aria-controls={`slide-${s.id}`} aria-current={i === 0 ? 'true' : undefined} aria-label={`Show slide ${i + 1}: ${s.title}`}>
          <span class="pill-bar" aria-hidden="true" />
          {s.tab}
        </button>
      ))
    }
  </div>
  <p class="mt-3 text-center text-xs text-ink-3">Illustrative interfaces with demo data, not client products or results.</p>
</section>

<style>
  .stage {
    container: showcase / inline-size;
    aspect-ratio: 640 / 590;
  }
  @container showcase (max-width: 620px) {
    .slide {
      zoom: 0.95;
    }
    /* Scaled-down stage (tablet/phone): pull the floating badges inside the frame so
       they never touch or cross the screen edge, even mid-float animation. */
    .float-a {
      right: 0.75rem;
      top: -1rem;
    }
    .float-b {
      left: 0.75rem;
      bottom: -1.25rem;
    }
  }
  @container showcase (max-width: 580px) {
    .slide {
      zoom: 0.89;
    }
  }
  @container showcase (max-width: 540px) {
    .slide {
      zoom: 0.83;
    }
  }
  @container showcase (max-width: 500px) {
    .slide {
      zoom: 0.77;
    }
  }
  @container showcase (max-width: 460px) {
    .slide {
      zoom: 0.71;
    }
  }
  @container showcase (max-width: 420px) {
    .slide {
      zoom: 0.65;
    }
  }
  @container showcase (max-width: 380px) {
    .slide {
      zoom: 0.59;
    }
  }
  @container showcase (max-width: 340px) {
    .slide {
      zoom: 0.53;
    }
  }
  @container showcase (max-width: 300px) {
    .slide {
      zoom: 0.46;
    }
  }

  .slide {
    position: absolute;
    top: 1.75rem;
    left: 0;
    width: 640px;
    opacity: 0;
    visibility: hidden;
    transform: translateX(18px) scale(0.985);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 0.7s;
  }
  .slide.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.7s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }
  .slide.is-leaving {
    transform: translateX(-18px) scale(0.985);
  }
  .slide:not(.is-active) :global(*) {
    animation-play-state: paused !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide,
    .slide.is-active,
    .slide.is-leaving {
      transform: none;
    }
  }

  /* indicators */
  .pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    overflow: hidden;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-ink-2);
    background: var(--color-card);
    box-shadow: inset 0 0 0 1.5px var(--color-line);
    transition:
      background-color 0.25s,
      color 0.25s,
      box-shadow 0.25s;
  }
  .pill:hover {
    box-shadow: inset 0 0 0 1.5px var(--color-ink);
  }
  .pill[aria-current='true'] {
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: none;
  }
  .pill-bar {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: var(--color-signal);
    transform-origin: left;
    transform: scaleX(0);
  }
  .showcase.is-running .pill[aria-current='true'] .pill-bar {
    animation: pill-progress var(--dur, 6000ms) linear forwards;
  }
  @keyframes pill-progress {
    to {
      transform: scaleX(1);
    }
  }

  /* ---------- resting (final) states: what reduced-motion users see ---------- */
  @property --score {
    syntax: '<integer>';
    inherits: false;
    initial-value: 100;
  }
  @property --rank {
    syntax: '<integer>';
    inherits: false;
    initial-value: 1;
  }
  @property --clicks {
    syntax: '<integer>';
    inherits: false;
    initial-value: 52;
  }
  @property --k1 {
    syntax: '<integer>';
    inherits: false;
    initial-value: 1;
  }
  @property --k2 {
    syntax: '<integer>';
    inherits: false;
    initial-value: 2;
  }
  @property --k3 {
    syntax: '<integer>';
    inherits: false;
    initial-value: 3;
  }
  .gauge {
    background:
      radial-gradient(closest-side, var(--color-card) 78%, transparent 80% 100%),
      conic-gradient(var(--color-moss) calc(var(--score) * 3.6deg), var(--color-paper-3) 0);
  }
  .score {
    counter-reset: s var(--score);
  }
  .score::after {
    content: counter(s);
  }
  .hero-img {
    background: linear-gradient(135deg, var(--color-paper-3), var(--color-paper-2) 50%, var(--color-moss-soft));
  }
  .lcp > *,
  .flip > * {
    grid-area: 1 / 1;
  }
  .lcp > * {
    text-align: right;
  }
  .lcp-slow,
  .s-wait {
    opacity: 0;
  }
  .m {
    background: var(--color-moss);
  }
  .load-line {
    transform-origin: left;
    opacity: 0;
  }
  .wire {
    fill: none;
    stroke: rgb(236 91 42 / 0.55);
    stroke-width: 2;
    stroke-dasharray: 6 8;
  }
  .pulse {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 999px;
    background: #ffd2bf;
    box-shadow:
      0 0 0 4px rgb(236 91 42 / 0.35),
      0 0 18px 6px rgb(236 91 42 / 0.6);
    offset-rotate: 0deg;
    offset-distance: 100%;
    opacity: 0;
  }
  .rank {
    counter-reset: r var(--rank);
  }
  .rank::after {
    content: '#' counter(r);
  }
  .clicks {
    counter-reset: c var(--clicks);
  }
  .clicks::after {
    content: counter(c) ' clicks';
  }
  .k1 {
    counter-reset: p var(--k1);
  }
  .k2 {
    counter-reset: p var(--k2);
  }
  .k3 {
    counter-reset: p var(--k3);
  }
  .pos::after {
    content: '#' counter(p);
  }
  .res-us {
    top: 0;
  }
  .res-them {
    top: 4.6rem;
  }
  .line {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 20ch;
  }
  .caret {
    width: 1.5px;
    height: 1rem;
    background: var(--color-ink);
    opacity: 0;
  }

  /* ---------- live sequences (only while active; restart on each visit) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    /* slide 2: page loads, sections build, score counts to 100, speed meter lights up */
    .slide.is-active .load-line {
      animation: load 0.9s cubic-bezier(0.45, 0, 0.2, 1) both;
    }
    .slide.is-active .w-in {
      animation: rise-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
      animation-delay: calc(0.35s + var(--i) * 0.12s);
    }
    .slide.is-active .float-a {
      animation: rise-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) 0.8s both;
    }
    .slide.is-active .gauge,
    .slide.is-active .score {
      animation: score 2s cubic-bezier(0.16, 1, 0.3, 1) 1.1s both;
    }
    .slide.is-active .lcp-slow {
      animation: show-until 2.6s linear both;
    }
    .slide.is-active .lcp-fast {
      animation: pop 0.4s cubic-bezier(0.16, 1, 0.3, 1) 2.6s both;
    }
    .slide.is-active .m1 {
      animation: meter 0.4s ease 1.6s both;
    }
    .slide.is-active .m2 {
