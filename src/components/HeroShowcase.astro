<script>
  const DUR = 6000;
  document.querySelectorAll<HTMLElement>('[data-showcase]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const pills = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    root.style.setProperty('--dur', `${DUR}ms`);
    let active = 0;
    let visible = true;
    let timer: number | undefined;

    // Loops forever. Only idles while off-screen or in a background tab.
    const running = () => visible && !document.hidden;
    const schedule = () => {
      window.clearTimeout(timer);
      const on = running();
      root.classList.toggle('is-running', on);
      if (on) timer = window.setTimeout(() => go(active + 1), DUR);
    };
    const restartBar = () => {
      const bar = pills[active]!.querySelector<HTMLElement>('.pill-bar');
      if (!bar) return;
      bar.style.animation = 'none';
      void bar.offsetWidth;
      bar.style.animation = '';
    };
    const go = (i: number) => {
      const next = (i + slides.length) % slides.length;
      if (next !== active) {
        const prev = slides[active]!;
        prev.classList.remove('is-active');
        prev.classList.add('is-leaving');
        prev.setAttribute('aria-hidden', 'true');
        prev.inert = true;
        window.setTimeout(() => prev.classList.remove('is-leaving'), 700);
        const el = slides[next]!;
        el.classList.add('is-active');
        el.removeAttribute('aria-hidden');
        el.inert = false;
        active = next;
        document.dispatchEvent(new CustomEvent('showcase:change', { detail: { index: active } }));
      }
      pills.forEach((p, n) => (n === active ? p.setAttribute('aria-current', 'true') : p.removeAttribute('aria-current')));
      restartBar();
      schedule();
    };

    pills.forEach((p, i) => p.addEventListener('click', () => go(i)));
    document.addEventListener('visibilitychange', schedule);
    new IntersectionObserver(([e]) => ((visible = !!e?.isIntersecting), schedule()), { threshold: 0.2 }).observe(root);
    schedule();
  });
</script>
