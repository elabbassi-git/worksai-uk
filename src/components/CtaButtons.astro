---
import { whatsappLink } from '@/config/site';
interface Props {
  whatsappMessage?: string;
  dark?: boolean;
  class?: string;
  showWhatsapp?: boolean;
}
const { whatsappMessage, class: cls, showWhatsapp = true } = Astro.props;
---

<div class:list={['flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center', cls]}>
  <a href="/free-ai-audit/" class="btn btn-primary" data-event="audit_booking_click">
    Book a free 30-minute AI audit
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
  </a>
  <a href="/free-seo-check/" class="btn btn-secondary">Get a free website & SEO check</a>
  {
    showWhatsapp && (
      <a href={whatsappLink(whatsappMessage)} class="btn btn-ghost" data-event="whatsapp_click" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
          <path
            fill="currentColor"
            d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
          />
        </svg>
        Chat on WhatsApp
      </a>
    )
  }
</div>
