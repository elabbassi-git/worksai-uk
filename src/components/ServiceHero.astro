---
/**
 * Live, continuously looping hero mockup for each service page.
 * - Each variant plays a one-off sequence showing how that service works; a tiny script
 *   restarts it every cycle (no pause control; idles only when off-screen / tab hidden).
 * - Laid out at 560 px and scaled with container queries inside a fixed-ratio stage: CLS 0.
 * - Base styles are the final state, so reduced-motion and no-JS visitors see a complete picture.
 * All content is illustrative demo data.
 */
import PlatformMockup from './PlatformMockup.astro';

export type Kind = 'saas' | 'call' | 'chat' | 'agents' | 'maps' | 'aiapp' | 'web' | 'booking' | 'invoice';
interface Props {
  kind: Kind;
  label: string;
}
const { kind, label } = Astro.props;
const cycle = { saas: 7500, call: 8500, chat: 8000, agents: 8000, maps: 8000, aiapp: 8000, web: 7500, booking: 8000, invoice: 8000 }[kind];

const slots = ['9:00', '10:30', '12:00', '14:00'];
const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
const taken = new Set(['0-0', '0-2', '1-1', '2-0', '2-3', '3-1', '4-2', '4-0']);
const agentWires = {
  w1: 'M150 60 C 205 60, 200 150, 236 150',
  w2: 'M150 150 L 236 150',
  w3: 'M150 240 C 205 240, 200 150, 236 150',
  o1: 'M352 150 C 390 150, 380 70, 410 70',
  o2: 'M352 150 C 390 150, 380 230, 410 230',
};
---

<div class="live-hero relative mx-auto w-full max-w-[38rem]" data-live data-cycle={cycle} role="img" aria-label={`Animated illustration: ${label}`}>
  <div class="live-stage relative">
    <div class="live-inner is-on" data-live-inner aria-hidden="true">
      {kind === 'saas' && <PlatformMockup />}

      {
        kind === 'call' && (
          <div class="relative h-[440px]">
            <div class="absolute left-6 top-0 w-[280px] rounded-[2.2rem] bg-night p-2.5 shadow-[0_50px_90px_-45px_rgb(21_23_28/0.6)]">
              <div class="rounded-[1.8rem] bg-gradient-to-b from-night-2 to-night px-4 pb-4 pt-6 text-paper">
                <p class="text-center text-[0.65rem] uppercase tracking-[0.2em] text-paper/60">Incoming call</p>
                <div class="relative mx-auto mt-4 grid size-16 place-items-center">
                  <span class="ring absolute inset-0 rounded-full bg-signal/30" />
                  <span class="relative grid size-16 place-items-center rounded-full bg-signal font-display text-xl font-semibold text-ink">AI</span>
                </div>
                <p class="mt-3 text-center font-display text-lg font-semibold">Example Physio Clinic</p>
                <p class="text-center font-mono text-xs text-paper/70">
                  <span class="blink mr-1 inline-block size-1.5 rounded-full bg-[#4ade80] align-middle" />
                  Live · <span class="timer" />
                </p>
                <div class="wave mx-auto mt-3 flex h-8 items-center justify-center gap-[3px]">
                  {Array.from({ length: 24 }, (_, i) => (
                    <span style={`--h:${25 + ((i * 37) % 70)}%; --d:${(i % 7) * 0.09}s`} />
                  ))}
                </div>
                <div class="mt-3 grid gap-2 text-[0.74rem] leading-snug">
                  <p class="b-ai seq" style="--t:0.5s">Thanks for calling Example Physio. I'm the clinic's AI assistant. How can I help?</p>
                  <p class="b-in seq" style="--t:1.9s">Can I be seen this week for a sore back?</p>
                  <p class="b-ai seq" style="--t:3.3s">I have Tuesday at 10:00. Shall I book it?</p>
                  <p class="b-in seq" style="--t:4.6s">Yes please.</p>
                </div>
              </div>
            </div>
            <div class="seq absolute right-2 top-16 w-[220px] rounded-2xl bg-card p-4 shadow-[var(--shadow-lift)] ring-1 ring-line" style="--t:5.4s">
              <p class="eyebrow">Calendar</p>
              <p class="mt-1 font-display text-lg font-semibold">Tue 10:00 · Booked ✓</p>
              <p class="text-sm text-ink-3">Initial assessment · 45 min</p>
            </div>
            <div class="seq absolute bottom-6 right-6 w-[230px] rounded-2xl bg-moss p-4 text-paper shadow-[var(--shadow-lift)]" style="--t:6.3s">
              <p class="text-[0.65rem] uppercase tracking-wider text-paper/70">Summary sent by WhatsApp</p>
              <p class="mt-1 text-sm">Back pain since Friday, no red flags. Prefers text reminders.</p>
            </div>
          </div>
        )
      }

      {
        kind === 'chat' && (
          <div class="relative h-[440px]">
            <div class="absolute left-8 top-0 w-[290px] overflow-hidden rounded-[2.2rem] bg-night p-2.5 shadow-[0_50px_90px_-45px_rgb(21_23_28/0.6)]">
              <div class="overflow-hidden rounded-[1.8rem] bg-[#efe7da]">
                <div class="flex items-center gap-3 bg-moss px-4 py-3 text-paper">
                  <span class="grid size-9 place-items-center rounded-full bg-paper/15 font-display text-sm font-semibold">EG</span>
                  <div class="leading-tight">
                    <p class="text-sm font-semibold">Example Grooming</p>
                    <p class="text-[0.65rem] text-paper/75">WhatsApp · AI assistant</p>
                  </div>
                </div>
                <div class="grid h-[340px] content-start gap-2 p-3 text-[0.76rem] leading-snug">
                  <p class="c-in seq" style="--t:0.4s">Hi! Are you free Saturday for a cockapoo groom? 🐶</p>
                  <p class="c-typing seq-blip" style="--t:1s"><i /><i /><i /></p>
                  <p class="c-out seq" style="--t:1.9s">Hi! Yes, Saturday has space. Is it her first visit with us?</p>
                  <p class="c-in seq" style="--t:3.1s">First time, she's a bit nervous.</p>
                  <p class="c-out seq" style="--t:4s">No problem, I'll book a calmer slot: Sat 9:00. Shall I confirm?</p>
                  <p class="c-in seq" style="--t:5s">Yes please!</p>
                  <p class="c-card seq" style="--t:5.7s">Booked ✓ Sat 9:00 · reminder the day before</p>
                </div>
              </div>
            </div>
            <div class="seq absolute right-3 top-10 rounded-2xl bg-card px-4 py-3 shadow-[var(--shadow-lift)] ring-1 ring-line" style="--t:2.1s">
              <p class="eyebrow">Response time</p>
              <p class="font-display text-2xl font-semibold">3 seconds</p>
            </div>
            <div class="seq absolute bottom-10 right-3 w-[210px] rounded-2xl bg-ink p-4 text-paper shadow-[var(--shadow-lift)]" style="--t:6.2s">
              <p class="text-[0.65rem] uppercase tracking-wider text-paper/60">Lead saved to CRM ✓</p>
              <p class="mt-1 text-sm">New client · nervous dog flagged for the groomer</p>
            </div>
          </div>
        )
      }

      {
        kind === 'agents' && (
          <div class="relative h-[440px] overflow-hidden rounded-[1.4rem] bg-night p-5 text-paper shadow-[0_60px_120px_-50px_rgb(21_23_28/0.7)]">
            <div class="flex items-center justify-between text-[0.72rem]">
              <span class="font-display text-sm font-semibold">AI agent · live</span>
              <span class="flex items-center gap-2 rounded-full bg-paper/10 px-2.5 py-1"><i class="blink size-2 rounded-full bg-[#4ade80]" />3 conversations</span>
            </div>
            <div class="relative mt-3 h-[300px] w-[520px] text-[0.72rem]">
              <svg class="absolute inset-0" width="520" height="300" viewBox="0 0 520 300">
                {Object.values(agentWires).map((d) => <path class="wire" d={d} />)}
              </svg>
              {Object.entries(agentWires).map(([k, d]) => <span class={`pulse pulse-${k}`} style={`offset-path: path('${d}')`} />)}
              {[
                ['WhatsApp', '“Viewing on Park Rd?”', 60, 0.3],
                ['Website chat', '“Is it pet friendly?”', 150, 0.6],
                ['Phone', 'Caller asking for Sam', 240, 0.9],
              ].map(([n, s, y, t]) => (
                <div class="node seq absolute left-0 w-[150px] -translate-y-1/2 rounded-xl bg-paper/10 p-2.5 ring-1 ring-paper/15" style={`top:${y}px; --t:${t}s`}>
                  <p class="text-[0.6rem] uppercase tracking-wider opacity-70">Incoming</p>
                  <p class="font-semibold">{n}</p>
                  <p class="opacity-80">{s}</p>
                </div>
              ))}
              <div class="agent absolute left-[236px] top-[150px] w-[116px] -translate-y-1/2 rounded-xl bg-signal p-2.5 text-ink">
                <p class="text-[0.6rem] uppercase tracking-wider opacity-70">AI agent</p>
                <p class="font-semibold leading-tight">Understands & acts</p>
                <p class="flip grid"><span class="s-wait">Thinking…</span><span class="s-done font-semibold">3 handled ✓</span></p>
              </div>
              <div class="seq absolute left-[410px] top-[70px] w-[110px] -translate-y-1/2 rounded-xl bg-paper/10 p-2.5 ring-1 ring-paper/15" style="--t:3.4s">
                <p class="text-[0.6rem] uppercase tracking-wider opacity-70">Calendar</p>
                <p class="font-semibold text-[#86efac]">Thu 17:30 ✓</p>
              </div>
              <div class="seq absolute left-[410px] top-[230px] w-[110px] -translate-y-1/2 rounded-xl bg-paper/10 p-2.5 ring-1 ring-paper/15" style="--t:3.7s">
                <p class="text-[0.6rem] uppercase tracking-wider opacity-70">Your team</p>
                <p class="font-semibold">Sam notified</p>
              </div>
            </div>
            <div class="mt-2 rounded-xl bg-paper/5 p-3 ring-1 ring-paper/10">
              <p class="text-[0.6rem] uppercase tracking-wider text-paper/60">CRM · updated live</p>
              <div class="mt-2 grid gap-1.5 font-mono text-[0.66rem]">
                <p class="seq flex justify-between" style="--t:4.3s"><span>J. Khan · viewing</span><span class="text-[#86efac]">Booked</span></p>
                <p class="seq flex justify-between" style="--t:4.8s"><span>M. Ellis · pets query</span><span class="text-[#86efac]">Answered</span></p>
                <p class="seq flex justify-between" style="--t:5.3s"><span>Caller · asked for Sam</span><span class="text-[#fbbf24]">Handed over</span></p>
              </div>
            </div>
          </div>
        )
      }

      {
        kind === 'maps' && (
          <div class="relative h-[440px]">
            <div class="overflow-hidden rounded-[1.4rem] border border-ink/10 bg-card shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
              <div class="p-4">
                <div class="flex items-center gap-2 rounded-full bg-paper px-3 py-2 text-[0.78rem] ring-1 ring-line">
                  <svg width="14" height="14" viewBox="0 0 24 24" class="text-ink-3"><path d="M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Zm10 3-5-5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
                  <span class="typed" style="--ch:20">dog groomer near me</span>
                </div>
              </div>
              <div class="map relative h-[150px]">
                {[
                  [18, 40, 'pin-them'],
                  [70, 30, 'pin-them'],
                  [55, 70, 'pin-them'],
                ].map(([x, y, c]) => (
                  <span class={`pin ${c}`} style={`left:${x}%;top:${y}%`} />
                ))}
                <span class="pin pin-us" style="left:38%;top:48%" />
              </div>
              <div class="relative h-[150px] px-4 pt-3">
                <div class="pack pack-us absolute inset-x-4 flex items-center gap-3 rounded-xl bg-card p-2.5 shadow-[var(--shadow-card)] ring-1 ring-signal/50 text-[0.74rem]">
                  <span class="rank grid size-8 place-items-center rounded-lg bg-signal font-display font-bold text-ink" />
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold">Example Mobile Grooming</p>
                    <p class="text-ink-3">★ 4.9 · <span class="reviews" /> · Open now</p>
                  </div>
                  <span class="rounded-full bg-moss px-2 py-1 text-[0.65rem] font-semibold text-paper">Call</span>
                </div>
                <div class="pack pack-them absolute inset-x-4 flex items-center gap-3 rounded-xl bg-paper/70 p-2.5 ring-1 ring-line text-[0.74rem]">
                  <span class="grid size-8 place-items-center rounded-lg bg-paper-2 font-display font-bold text-ink-3">#2</span>
                  <div class="min-w-0 flex-1">
                    <p class="font-semibold">Another Groomer</p>
                    <p class="text-ink-3">★ 4.6 · 31 reviews</p>
                  </div>
                </div>
              </div>
            </div>
            <div class="seq absolute -right-2 top-24 w-[190px] rounded-2xl bg-ink p-4 text-paper shadow-[var(--shadow-lift)]" style="--t:3.6s">
              <p class="text-[0.65rem] uppercase tracking-wider text-paper/60">Calls from profile</p>
              <p class="calls font-display text-3xl font-semibold" />
              <p class="text-xs text-paper/70">↑ after the set-up</p>
            </div>
          </div>
        )
      }

      {
        kind === 'aiapp' && (
          <div class="overflow-hidden rounded-[1.4rem] border border-ink/10 bg-card shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
            <div class="flex items-center gap-3 border-b border-line bg-paper px-4 py-3">
              <span class="flex gap-1.5"><i class="size-2.5 rounded-full bg-[#f87171]" /><i class="size-2.5 rounded-full bg-[#fbbf24]" /><i class="size-2.5 rounded-full bg-[#4ade80]" /></span>
              <span class="mx-auto rounded-lg bg-card px-3 py-1 font-mono text-[0.68rem] text-ink-3 ring-1 ring-line">app.yourproduct.co.uk/search</span>
            </div>
            <div class="p-4 text-[0.74rem]">
              <div class="flex items-center gap-2 rounded-xl bg-paper px-3 py-2.5 ring-1 ring-ink/20">
                <svg width="14" height="14" viewBox="0 0 24 24" class="text-signal-deep"><path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8Z" fill="currentColor" /></svg>
                <span class="typed" style="--ch:34">Which contracts renew before March?</span>
              </div>
              <div class="mt-3 grid grid-cols-[1fr_1.25fr] gap-3">
                <div class="grid content-start gap-2">
                  {['Lease · Unit 4.pdf', 'Cleaning contract.pdf', 'Software licence.pdf'].map((f, i) => (
                    <div class="doc seq relative overflow-hidden rounded-xl bg-paper p-2.5 ring-1 ring-line" style={`--t:${1.4 + i * 0.25}s`}>
                      <p class="font-semibold">{f}</p>
                      <span class="mt-1.5 block h-1.5 w-full rounded bg-paper-3" />
                      <span class="hl mt-1 block h-1.5 w-2/3 rounded bg-signal-soft" style={`--t:${2 + i * 0.3}s`} />
                    </div>
                  ))}
                </div>
                <div class="rounded-xl bg-ink p-3 text-paper">
                  <p class="text-[0.6rem] uppercase tracking-wider text-paper/60">AI answer</p>
                  <p class="seq mt-2" style="--t:2.6s">3 contracts renew before March:</p>
                  <p class="seq mt-1" style="--t:3s">· Lease, Unit 4 · 28 Feb</p>
                  <p class="seq" style="--t:3.3s">· Cleaning · 1 Feb</p>
                  <p class="seq" style="--t:3.6s">· Software licence · 15 Jan</p>
                  <div class="seq mt-3" style="--t:4s">
                    <div class="flex justify-between text-[0.62rem] text-paper/70"><span>Confidence</span><span>High</span></div>
                    <div class="mt-1 h-1.5 rounded-full bg-paper/15"><span class="conf block h-full rounded-full bg-[#86efac]" /></div>
                  </div>
                  <p class="seq mt-3 rounded-lg bg-signal px-2 py-1.5 text-ink" style="--t:4.8s">1 date unclear: sent to a person to check</p>
                </div>
              </div>
            </div>
          </div>
        )
      }

      {
        kind === 'web' && (
          <div class="relative h-[440px]">
            <div class="overflow-hidden rounded-[1.4rem] border border-ink/10 bg-card shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
              <div class="flex items-center gap-3 border-b border-line bg-paper px-4 py-3">
                <span class="flex gap-1.5"><i class="size-2.5 rounded-full bg-[#f87171]" /><i class="size-2.5 rounded-full bg-[#fbbf24]" /><i class="size-2.5 rounded-full bg-[#4ade80]" /></span>
                <span class="mx-auto rounded-lg bg-card px-3 py-1 font-mono text-[0.68rem] text-ink-3 ring-1 ring-line">yourbusiness.co.uk</span>
              </div>
              <div class="load-line h-0.5 bg-signal" />
              <div class="p-5 text-[0.72rem]">
                <div class="seq flex items-center justify-between" style="--t:0.3s">
                  <span class="font-display text-sm font-semibold">Example Electrical</span>
                  <span class="rounded-full bg-ink px-2.5 py-1 font-semibold text-paper">Get a quote</span>
                </div>
                <p class="seq mt-4 font-display text-[1.5rem] font-semibold leading-[1.05]" style="--t:0.5s">EV chargers fitted across Derby</p>
                <p class="seq mt-2 text-ink-3" style="--t:0.7s">Registered electrician. Fixed quote after a free survey.</p>
                <div class="seq mt-3 flex gap-2" style="--t:0.9s">
                  <span class="rounded-full bg-signal px-3 py-1.5 font-semibold text-ink">Book a survey</span>
                  <span class="rounded-full px-3 py-1.5 font-semibold ring-1 ring-ink/40">Prices</span>
                </div>
                <div class="mt-4 grid grid-cols-3 gap-2">
                  {['Rewiring', 'Consumer units', 'EV chargers'].map((t, i) => (
                    <div class="seq rounded-xl bg-paper p-2.5 ring-1 ring-line" style={`--t:${1.1 + i * 0.15}s`}>
                      <span class="block size-5 rounded-md bg-signal-soft" />
                      <p class="mt-2 font-semibold">{t}</p>
                    </div>
                  ))}
                </div>
                <p class="seq mt-3 flex items-center gap-2 rounded-xl bg-moss-soft/70 p-2.5 font-semibold text-moss" style="--t:4.2s">AI chat: “Do you cover DE22?” · answered</p>
              </div>
            </div>
            <div class="seq absolute -right-3 -top-6 w-[200px] rounded-2xl bg-card p-3 shadow-[var(--shadow-lift)] ring-1 ring-line" style="--t:0.9s">
              <div class="flex items-center gap-3">
                <span class="gauge grid size-12 place-items-center rounded-full text-[0.85rem] font-bold text-moss"><span class="score" /></span>
                <span class="text-[0.72rem] leading-tight"><b class="block">Performance</b><span class="text-ink-3">Demo audit</span></span>
              </div>
              <div class="mt-2 flex justify-between text-[0.66rem] text-ink-3"><span>Load time</span><span class="flip grid font-semibold"><span class="s-wait text-[#b3261e]">3.8 s</span><span class="s-done text-moss">1.2 s</span></span></div>
              <div class="mt-1 grid grid-cols-3 gap-1"><span class="m h-1.5 rounded-full" style="--t:1.6s" /><span class="m h-1.5 rounded-full" style="--t:2.1s" /><span class="m h-1.5 rounded-full" style="--t:2.6s" /></div>
            </div>
          </div>
        )
      }

      {
        kind === 'booking' && (
          <div class="relative h-[440px]">
            <div class="overflow-hidden rounded-[1.4rem] border border-ink/10 bg-card p-4 shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
              <div class="flex items-center justify-between">
                <p class="font-display text-sm font-semibold">Book: Cut & colour · 2 hrs</p>
                <span class="rounded-full bg-paper-2 px-2 py-0.5 font-mono text-[0.6rem] text-ink-3">This week</span>
              </div>
              <div class="mt-3 grid grid-cols-5 gap-1.5 text-center text-[0.68rem]">
                {days.map((d) => <p class="font-semibold text-ink-3">{d}</p>)}
                {slots.map((t, r) =>
                  days.map((_, c) => {
                    const isTaken = taken.has(`${c}-${r}`);
                    const pick = c === 3 && r === 3;
                    return (
                      <span class:list={['slot rounded-lg px-1 py-2 ring-1', isTaken ? 'bg-paper-2 text-ink-3 line-through ring-line' : 'bg-card ring-line', pick && 'slot-pick']}>
                        {t}
                      </span>
                    );
                  }),
                )}
              </div>
              <div class="mt-3 flex items-center justify-between rounded-xl bg-paper p-3 text-[0.72rem] ring-1 ring-line">
                <span class="font-semibold">Thu 14:00 · Deposit</span>
                <span class="flip grid font-semibold"><span class="s-wait text-ink-3">Select a time</span><span class="s-done text-moss">Paid ✓</span></span>
              </div>
            </div>
            <div class="seq absolute -right-3 top-[220px] w-[230px] rounded-2xl bg-night p-3 text-paper shadow-[var(--shadow-lift)]" style="--t:4s">
              <p class="text-[0.6rem] uppercase tracking-wider text-paper/60">Text reminder · Wed 14:00</p>
              <p class="mt-1 text-[0.78rem]">See you tomorrow at 14:00! Need to change it? Tap to reschedule.</p>
            </div>
            <div class="seq absolute bottom-4 left-4 rounded-2xl bg-moss px-4 py-3 text-paper shadow-[var(--shadow-lift)]" style="--t:5.4s">
              <p class="font-display text-lg font-semibold">Confirmed ✓</p>
              <p class="text-xs text-paper/80">Email + text sent · added to your diary</p>
            </div>
          </div>
        )
      }

      {
        kind === 'invoice' && (
          <div class="relative h-[440px]">
            <div class="absolute left-0 top-0 w-[300px] rounded-[1.4rem] border border-ink/10 bg-card p-5 shadow-[0_60px_120px_-50px_rgb(21_23_28/0.55)]">
              <div class="flex items-start justify-between">
                <div>
                  <p class="eyebrow">Invoice</p>
                  <p class="font-display text-xl font-semibold">INV-1043</p>
                  <p class="text-sm text-ink-3">Example Design Studio</p>
                </div>
                <span class="status grid text-[0.68rem] font-semibold">
                  <span class="st st-1 rounded-full bg-paper-2 px-2 py-1 text-ink-2">Sent</span>
                  <span class="st st-2 rounded-full bg-[#fef3c7] px-2 py-1 text-[#92400e]">Due today</span>
                  <span class="st st-3 rounded-full bg-[#fde8e6] px-2 py-1 text-[#b3261e]">7 days late</span>
                  <span class="st st-4 rounded-full bg-moss px-2 py-1 text-paper">Paid ✓</span>
                </span>
              </div>
              <div class="mt-4 grid gap-1.5">
                <span class="h-2 w-full rounded bg-paper-3" />
                <span class="h-2 w-4/5 rounded bg-paper-3" />
                <span class="h-2 w-3/5 rounded bg-paper-3" />
              </div>
              <div class="mt-4 flex items-end justify-between border-t border-line pt-3">
                <p class="text-sm text-ink-3">Day <b class="day font-display text-2xl text-ink" /></p>
                <span class="rounded-full bg-signal px-3 py-1.5 text-xs font-semibold text-ink">Pay now</span>
              </div>
            </div>
            <ol class="absolute right-0 top-4 grid w-[230px] gap-3 text-[0.74rem]">
              {[
                ['Email', 'Friendly heads-up', 1.2],
                ['Email', 'Due-date reminder', 2.4],
                ['WhatsApp', 'Polite follow-up', 3.6],
                ['Payment', 'Paid via link ✓', 4.8],
              ].map(([c, t, d], i) => (
