<script>
  // Restart each live mockup's sequence every cycle. Loops forever; idles only off-screen / tab hidden.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-live]').forEach((root) => {
    if (reduce) return;
    const inner = root.querySelector<HTMLElement>('[data-live-inner]')!;
    const cycle = Number(root.dataset.cycle) || 8000;
    let visible = false;
    let timer: number | undefined;
    const restart = () => {
      inner.classList.remove('is-on');
      void inner.offsetWidth;
      inner.classList.add('is-on');
    };
    const schedule = () => {
      window.clearInterval(timer);
      if (visible && !document.hidden) timer = window.setInterval(restart, cycle);
    };
    new IntersectionObserver(([e]) => {
      const was = visible;
      visible = !!e?.isIntersecting;
      if (visible && !was) restart();
      schedule();
    }).observe(root);
    document.addEventListener('visibilitychange', schedule);
  });
</script>
