---
/** Contact details card (email, phone, WhatsApp, hours). Shared by Contact and Free AI audit. */
import { site, isSet, whatsappLink } from '@/config/site';
interface Props {
  whatsappMessage?: string;
}
const { whatsappMessage = 'Hello Works AI, I have a question.' } = Astro.props;
---

<div class="card p-6 sm:p-7">
  <h2 class="font-display text-h3 font-semibold">Contact details</h2>
  <ul class="mt-4 grid gap-1">
    {
      [
        { href: `mailto:${site.email}`, icon: 'M3 6h18v12H3zM3 7l9 6 9-6', label: site.email, sub: 'Email us any time' },
        { href: `tel:${site.phone}`, icon: 'M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2', label: site.phoneDisplay, sub: 'Call in UK business hours' },
        { href: whatsappLink(whatsappMessage), icon: 'M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.5A8 8 0 1 1 21 12Z', label: 'WhatsApp', sub: 'Message us, we reply in UK hours', event: 'whatsapp_click' },
      ].map((c) => (
        <li>
          <a href={c.href} class="group flex items-center gap-4 rounded-xl px-2 py-2.5 transition-colors hover:bg-paper" data-event={c.event} rel={c.event ? 'noopener' : undefined}>
            <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-paper-2 text-ink-2 transition-colors group-hover:bg-signal group-hover:text-ink" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24"><path d={c.icon} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <span>
              <span class="block font-semibold">{c.label}</span>
              <span class="block text-sm text-ink-3">{c.sub}</span>
            </span>
          </a>
        </li>
      ))
    }
    <li class="flex items-center gap-4 px-2 py-2.5">
      <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-paper-2 text-ink-2" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Zm0-13v5l3 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </span>
      <span>
        <span class="block font-semibold">{site.hours}</span>
        <span class="block text-sm text-ink-3">{site.location}{isSet(site.hoursNote) && ` ${site.hoursNote}`}</span>
      </span>
    </li>
  </ul>
</div>
