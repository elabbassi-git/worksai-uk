---
/** Stat cards. Only ever use sourced figures or our own published prices (pass `source`). */
import { fillPrices } from '@/data/pricing';
interface Props {
  items: { value: string; label: string }[];
  source?: string;
}
const { items, source } = Astro.props;
---

<figure class="not-prose my-10">
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-[repeat(auto-fit,minmax(10rem,1fr))]">
    {
      items.map((s, i) => (
        <div class="stat-card relative overflow-hidden rounded-2xl border border-line bg-card p-5 shadow-[var(--shadow-card)]" style={`--i:${i}`} data-reveal>
          <p class="stat-value font-display text-4xl font-semibold tracking-tight text-ink">{fillPrices(s.value)}</p>
          <p class="mt-2 text-sm leading-snug text-ink-2">{fillPrices(s.label)}</p>
          <span class="stat-bar absolute inset-x-0 bottom-0 h-1 origin-left bg-gradient-to-r from-signal to-signal-deep" aria-hidden="true" />
        </div>
      ))
    }
  </div>
  {source && <figcaption class="mt-3 text-xs text-ink-3">Source: {source}</figcaption>}
</figure>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stat-bar {
        animation: stat-bar linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 45%;
      }
      .stat-value {
        animation: stat-pop linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 35%;
      }
    }
  }
  @keyframes stat-bar {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes stat-pop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.92);
    }
  }
</style>
