---
import { services, formatGBP, pricingModel, type ServicePriceKey, type ServicePrice } from '@/data/pricing';
interface Props {
  priceKey: ServicePriceKey;
}
const { priceKey } = Astro.props;
const p: ServicePrice = services[priceKey];
---

<div class="card overflow-hidden">
  <div class="grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_1.3fr] lg:items-center">
    <div>
      <p class="eyebrow">One-time payment</p>
      {
        p.onRequest || p.build == null ? (
          <p class="mt-3 font-display text-4xl font-semibold tracking-tight">Price on request</p>
        ) : (
          <p class="mt-3 font-display text-6xl font-semibold tracking-tight">
            {p.from && <span class="align-top text-lg font-medium text-ink-3">from </span>}
            {formatGBP(p.build)}
          </p>
        )
      }
      <p class="mt-2 text-sm text-ink-3">{p.onRequest ? 'Fixed quote after a free audit, paid once.' : 'Paid once. No monthly fees, no retainer.'}</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-3">
      {
        [
          ['Pay once', 'A fixed, one-off price agreed before work starts.'],
          ['Own it', 'Code, accounts and data set up in your name.'],
          ['No lock-in', 'Documented and handed over, so you are never tied to us.'],
        ].map(([t, d]) => (
          <li class="rounded-2xl bg-paper p-4">
            <p class="font-display font-semibold">{t}</p>
            <p class="mt-1 text-sm text-ink-2">{d}</p>
          </li>
        ))
      }
    </ul>
  </div>
  <div class="grid gap-8 border-t border-line p-6 sm:grid-cols-2 sm:p-8">
    <div>
      <h3 class="font-display text-lg font-semibold">What's included</h3>
      <ul class="mt-3 grid gap-2 text-ink-2">
        {
          p.includes.map((i) => (
            <li class="flex gap-3">
              <svg class="mt-1 shrink-0 text-moss" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="m3 8.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
              {i}
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h3 class="font-display text-lg font-semibold">Not included</h3>
      <ul class="mt-3 grid gap-2 text-ink-2">
        {
          p.excludes.map((i) => (
            <li class="flex gap-3">
              <svg class="mt-1 shrink-0 text-ink-3" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M4 8h8" fill="none" stroke="currentColor" stroke-width="2" />
              </svg>
              {i}
            </li>
          ))
        }
      </ul>
      <p class="mt-4 text-sm text-ink-3">Post-launch support: {pricingModel.postLaunchSupport}</p>
    </div>
  </div>
  <div class="flex flex-col gap-3 border-t border-line bg-paper-2/60 px-6 py-5 text-sm sm:flex-row sm:items-center sm:justify-between sm:px-8">
    <p class="text-ink-2">Prices in pounds sterling (GBP). Any running costs are paid directly to providers, never marked up by us.</p>
    <a href="/pricing/" class="link font-semibold">See all Works AI prices</a>
  </div>
</div>
