---
import type { Crumb } from '@/lib/schema';
interface Props {
  crumbs: Crumb[];
}
const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="container-x pt-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-ink-3">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && (
            <span aria-hidden="true" class="text-line-strong">
              /
            </span>
          )}
          {i === crumbs.length - 1 ? (
            <span aria-current="page" class="text-ink-2">
              {c.name}
            </span>
          ) : (
            <a href={c.path} class="underline decoration-line-strong underline-offset-4 hover:text-ink hover:decoration-signal">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
