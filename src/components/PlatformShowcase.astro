---
/** "What we build" bento: six illustrative mini-interfaces (demo data, HTML/CSS only). */
---

<div class="showcase grid gap-4 md:grid-cols-6">
  <!-- 1. Multi-tenant SaaS -->
  <a href="/services/saas-development/" class="cell group card card-link relative overflow-hidden p-6 md:col-span-4 md:row-span-2 sm:p-8">
    <p class="eyebrow">Multi-tenant SaaS platforms</p>
    <h3 class="mt-3 max-w-md font-display text-h2 font-semibold">One platform, many customers, every account isolated</h3>
    <p class="mt-3 max-w-lg text-ink-2">Organisations, roles, billing and admin, built to production standard and handed over with the code.</p>
    <div class="mt-8 grid gap-3 sm:grid-cols-3" aria-hidden="true">
      {
        [
          ['Northwind Ltd', 'N', 'bg-moss', '24 users', 'Owner'],
          ['Riverside Clinics', 'R', 'bg-signal', '58 users', 'Admin'],
          ['Harbour Legal', 'H', 'bg-ink', '11 users', 'Member'],
        ].map(([n, l, c, u, r], i) => (
          <div class="tenant-card rounded-2xl border border-line bg-paper p-4" style={`--i:${i}`}>
            <div class="flex items-center gap-2">
              <span class={`grid size-8 place-items-center rounded-lg font-semibold text-paper ${c}`}>{l}</span>
              <span class="min-w-0 truncate font-semibold">{n}</span>
            </div>
            <div class="mt-4 flex items-center justify-between text-sm text-ink-3">
              <span>{u}</span>
              <span class="rounded-full bg-card px-2 py-0.5 text-xs ring-1 ring-line">{r}</span>
            </div>
            <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-paper-3"><span class="usage block h-full rounded-full bg-signal" style={`--w:${[72, 88, 41][i]}%`} /></div>
          </div>
        ))
      }
    </div>
    <span class="link mt-8 inline-block font-semibold">Explore SaaS and platform development</span>
  </a>

  <!-- 2. Dashboards -->
  <a href="/services/saas-development/" class="cell card card-link overflow-hidden p-6 md:col-span-2">
    <p class="eyebrow">Live dashboards</p>
    <h3 class="mt-3 font-display text-h3 font-semibold">Every number on one screen</h3>
    <div class="mini-chart mt-5 flex h-20 items-end gap-1.5" aria-hidden="true">
      {[30, 45, 38, 60, 52, 70, 64, 82].map((h, i) => <span style={`--h:${h}%; --i:${i}`} />)}
    </div>
  </a>

  <!-- 3. AI apps -->
  <a href="/services/ai-web-development/" class="cell card card-link overflow-hidden bg-ink p-6 text-paper md:col-span-2">
    <p class="eyebrow !text-paper/60">AI-powered web apps</p>
    <h3 class="mt-3 font-display text-h3 font-semibold">Search, read and answer</h3>
    <div class="mt-5 grid gap-2 text-sm" aria-hidden="true">
      <p class="rounded-xl bg-paper/10 px-3 py-2">🔎 contracts renewing before March</p>
      <p class="ai-answer rounded-xl bg-signal px-3 py-2 text-ink">Found 7 contracts · 2 need review</p>
    </div>
  </a>

  <!-- 4. Portals -->
  <a href="/services/saas-development/" class="cell card card-link overflow-hidden p-6 md:col-span-2">
    <p class="eyebrow">Customer portals</p>
    <h3 class="mt-3 font-display text-h3 font-semibold">Uploads, status and messages</h3>
    <ul class="mt-5 grid gap-2 text-sm" aria-hidden="true">
      {
        [
          ['passport.pdf', 100],
          ['bank-statements.zip', 64],
        ].map(([f, p]) => (
          <li class="rounded-xl bg-paper p-2.5 ring-1 ring-line">
            <div class="flex justify-between">
              <span class="truncate">{f}</span>
              <span class="text-ink-3">{p}%</span>
            </div>
            <div class="mt-1.5 h-1 rounded-full bg-paper-3">
              <span class="usage block h-full rounded-full bg-moss" style={`--w:${p}%`} />
            </div>
          </li>
        ))
      }
    </ul>
  </a>

  <!-- 5. Roles & security -->
  <a href="/services/saas-development/" class="cell card card-link overflow-hidden p-6 md:col-span-2">
    <p class="eyebrow">Roles & security</p>
    <h3 class="mt-3 font-display text-h3 font-semibold">The right access for every user</h3>
    <ul class="mt-5 grid gap-2 text-sm" aria-hidden="true">
      {
        [
          ['View reports', true],
          ['Manage billing', true],
          ['Delete organisation', false],
        ].map(([t, on]) => (
          <li class="flex items-center justify-between rounded-xl bg-paper px-3 py-2 ring-1 ring-line">
            {t}
            <span class:list={['toggle relative h-5 w-9 rounded-full', on ? 'bg-moss' : 'bg-line-strong']}>
              <span class:list={['absolute top-0.5 size-4 rounded-full bg-card transition-all', on ? 'left-[1.1rem]' : 'left-0.5']} />
            </span>
          </li>
        ))
      }
    </ul>
  </a>

  <!-- 6. Payments -->
  <a href="/services/saas-development/" class="cell card card-link overflow-hidden p-6 md:col-span-2">
    <p class="eyebrow">Payments built in</p>
    <h3 class="mt-3 font-display text-h3 font-semibold">Checkout, invoices and receipts</h3>
    <div class="mt-5 rounded-xl bg-paper p-3 text-sm ring-1 ring-line" aria-hidden="true">
      <div class="flex items-center justify-between">
        <span class="font-semibold">INV-1043</span>
        <span class="rounded-full bg-moss-soft px-2 py-0.5 text-xs font-semibold text-moss">Paid ✓</span>
      </div>
      <p class="mt-1 text-ink-3">Card payment · receipt emailed</p>
    </div>
  </a>
</div>
<p class="mt-5 text-center text-xs text-ink-3">Illustrative interfaces with demo data, not client products.</p>

<style>
  .mini-chart span {
    flex: 1;
    height: var(--h);
    border-radius: 4px 4px 1px 1px;
    background: linear-gradient(to top, var(--color-signal-deep), var(--color-signal));
    transform-origin: bottom;
  }
  .usage {
    width: var(--w);
  }
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .mini-chart span {
        animation: bar linear both;
        animation-timeline: view();
        animation-range: entry 10% cover 40%;
      }
      .usage {
        animation: fill linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 35%;
      }
    }
    .cell:hover .tenant-card {
      transform: translateY(calc(var(--i) * -3px - 3px));
    }
    .tenant-card {
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cell:hover .ai-answer {
      transform: scale(1.03);
    }
    .ai-answer {
      transition: transform 0.25s ease;
    }
  }
  @keyframes bar {
    from {
      transform: scaleY(0.08);
    }
  }
  @keyframes fill {
    from {
      width: 0;
    }
  }
</style>
