---
/**
 * Interactive "How it works" explorer.
 * - Optional `diagram`: a bespoke animated workflow for this specific service
 *   (own topology, live statuses, data packets moving along active connections).
 * - Auto-plays as soon as it is on screen; a visitor click pauses briefly, then it resumes.
 *   Loops continuously (no pause control, by owner decision).
 * - Without JS: every stage is readable as a list and the diagram shows its first state.
 */
import { fillPrices } from '@/data/pricing';
import { icons, type Diagram } from '@/data/diagrams';

export type Stage = {
  actor: 'customer' | 'ai' | 'you' | 'us';
  title: string;
  text: string;
  preview?: string;
};
interface Props {
  stages: Stage[];
  id: string;
  label: string;
  diagram?: Diagram;
}
const { stages, id, label, diagram } = Astro.props;

const actors = {
  customer: { name: 'Your customer', short: 'Customer', cls: 'bg-paper-3 text-ink' },
  ai: { name: 'AI / automation', short: 'AI', cls: 'bg-signal text-ink' },
  you: { name: 'You or your team', short: 'You', cls: 'bg-moss text-paper' },
  us: { name: 'Works AI', short: 'Works AI', cls: 'bg-ink text-paper' },
} as const;
const stageIcons: Record<Stage['actor'], string> = {
  customer: icons.user,
  ai: icons.ai,
  you: icons.key,
  us: icons.code,
};

/* ---- diagram geometry, computed at build time ---- */
const W = 1000;
const H = 400;
const nodeById = new Map(diagram?.nodes.map((n) => [n.id, n]));
const edgePath = (from: string, to: string, bend = 0) => {
  const a = nodeById.get(from)!;
  const b = nodeById.get(to)!;
  const dx = b.x - a.x;
  const dy = b.y - a.y;
  if (bend) {
    const mx = (a.x + b.x) / 2;
    const my = (a.y + b.y) / 2 + bend * 1.6;
    return `M${a.x} ${a.y} Q${mx} ${my} ${b.x} ${b.y}`;
  }
  if (Math.abs(dx) >= Math.abs(dy)) {
    const c = dx * 0.5;
    return `M${a.x} ${a.y} C${a.x + c} ${a.y} ${b.x - c} ${b.y} ${b.x} ${b.y}`;
  }
  const c = dy * 0.5;
  return `M${a.x} ${a.y} C${a.x} ${a.y + c} ${b.x} ${b.y - c} ${b.x} ${b.y}`;
};
/** For each node, its status text at every step (cumulative). */
const statusTimeline = (nodeId: string) => {
  let last = '';
  return (diagram?.steps ?? []).map((s) => (last = s.status?.[nodeId] ?? last));
};
const stepsFor = (kind: 'nodes' | 'edges', itemId: string) =>
  (diagram?.steps ?? [])
    .map((s, i) => ((s[kind] as string[]).includes(itemId) ? i : -1))
    .filter((i) => i >= 0)
    .join(',');
---

<div class="process card overflow-hidden" data-process id={id} style={`--steps:${stages.length}`}>
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4 sm:px-7">
    <div>
      <p class="font-display text-lg font-semibold">{label}</p>
      {diagram && <p class="text-sm text-ink-3">{diagram.headline}</p>}
    </div>
    <div class="flex items-center gap-3">
      <span class="autoplay-pill items-center gap-2 rounded-full bg-paper-2 px-3 py-1 text-xs font-semibold text-ink-2" data-autoplay-pill>
        <span class="live-dot size-2 rounded-full bg-signal" aria-hidden="true"></span>
        <span data-autoplay-label>Playing</span>
      </span>
      <ul class="hidden flex-wrap gap-2 text-xs sm:flex" aria-label="Who does what">
        {
          [...new Set(stages.map((s) => s.actor))].map((a) => (
            <li class={`rounded-full px-2.5 py-1 font-semibold ${actors[a].cls}`}>{actors[a].name}</li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    diagram && (
      <div class="diagram-scroll overflow-x-auto border-b border-line bg-paper/60" data-diagram-scroll>
        <div class="diagram relative mx-auto" style={`aspect-ratio:${W}/${H}`} data-diagram role="img" aria-label={`Animated diagram: ${diagram.headline}`}>
          <div aria-hidden="true" class="diagram-grid absolute inset-0" />
          <svg class="absolute inset-0 size-full" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
            {diagram.edges.map((e) => {
              const d = edgePath(e.from, e.to, e.bend);
              return (
                <g class="dedge" data-edge={e.id} data-steps={stepsFor('edges', e.id)}>
                  <path d={d} class:list={['edge-base', e.dashed && 'is-dashed']} vector-effect="non-scaling-stroke" />
                  <path d={d} class="edge-flow" vector-effect="non-scaling-stroke" />
                  <circle r="6" class="edge-packet">
                    <animateMotion dur="1.6s" repeatCount="indefinite" path={d} />
                  </circle>
                </g>
              );
            })}
          </svg>
          {diagram.nodes.map((n) => {
            const timeline = statusTimeline(n.id);
            return (
              <div
                class={`dnode tone-${n.tone ?? 'tool'}`}
                style={`left:${(n.x / W) * 100}%;top:${(n.y / H) * 100}%`}
                data-node={n.id}
                data-steps={stepsFor('nodes', n.id)}
                data-status={JSON.stringify(timeline)}
                aria-hidden="true"
              >
                <span class="dicon">
                  <svg width="18" height="18" viewBox="0 0 24 24">
                    <path d={icons[n.icon]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="dtext">
                  <span class="dlabel">{n.label}</span>
                  <span class="dstatus" data-status-text>{timeline[0]}</span>
                </span>
              </div>
            );
          })}
        </div>
      </div>
    )
  }

  <!-- Rail (tabs once enhanced) -->
  <div class="process-rail relative px-5 pt-6 sm:px-7" hidden data-rail>
    <div class="absolute left-[calc(1.25rem+1.25rem)] right-[calc(1.25rem+1.25rem)] top-[calc(1.5rem+1.25rem)] h-0.5 bg-line sm:left-[calc(1.75rem+1.25rem)] sm:right-[calc(1.75rem+1.25rem)]" aria-hidden="true">
      <div class="process-fill h-full origin-left bg-signal"></div>
      <span class="process-signal"></span>
    </div>
    <div role="tablist" aria-label={label} class="relative grid gap-2" style="grid-template-columns: repeat(var(--steps), minmax(0, 1fr));">
      {
        stages.map((s, i) => (
          <button
            type="button"
            role="tab"
            id={`${id}-tab-${i}`}
            aria-controls={`${id}-panel-${i}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            class="process-tab group flex flex-col items-center gap-2 rounded-xl pb-4 text-center"
            data-index={i}
          >
            <span class="process-node relative grid size-10 place-items-center rounded-full border-2 border-line-strong bg-card transition-all duration-300">
              <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true">
                <path d={stageIcons[s.actor]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="tab-timer" aria-hidden="true" />
            </span>
            <span class="hidden text-xs font-semibold leading-tight text-ink-3 group-aria-selected:text-ink md:block">{s.title}</span>
            <span class="sr-only md:hidden">{s.title}</span>
          </button>
        ))
      }
    </div>
  </div>

  <!-- Panels: a readable list without JS -->
  <div class="process-panels grid" data-panels>
    {
      stages.map((s, i) => (
        <div id={`${id}-panel-${i}`} data-labelledby={`${id}-tab-${i}`} class="process-panel grid gap-6 border-t border-line p-5 sm:p-7 md:grid-cols-[1.1fr_1fr]" data-panel={i}>
          <div>
            <p class="flex items-center gap-3">
              <span class="font-mono text-sm text-signal-deep">
                Step {i + 1} of {stages.length}
              </span>
              <span class={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${actors[s.actor].cls}`}>{actors[s.actor].short}</span>
            </p>
            <h3 class="mt-3 font-display text-h3 font-semibold">{s.title}</h3>
            <p class="mt-2 text-ink-2">{fillPrices(s.text)}</p>
          </div>
          {s.preview && (
            <div class="process-preview relative self-start rounded-2xl bg-paper p-4" aria-hidden="true">
              <p class="mb-2 text-[0.7rem] font-semibold uppercase tracking-wider text-ink-3">Illustrative preview</p>
              <p class:list={['preview-bubble', s.actor === 'customer' ? 'is-in' : 'is-out']}>{fillPrices(s.preview)}</p>
            </div>
          )}
        </div>
      ))
    }
  </div>

  <div class="flex items-center justify-between gap-4 border-t border-line px-5 py-3 sm:px-7" hidden data-controls>
    <div class="flex gap-2">
      <button type="button" class="process-btn" data-prev aria-label="Previous step">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
      </button>
      <button type="button" class="process-btn" data-next aria-label="Next step">
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" /></svg>
      </button>
    </div>

  </div>
</div>

<style>
  /* ---------- diagram ---------- */
  .diagram {
    min-width: 720px;
    max-width: 1100px;
    margin: 0.75rem auto;
  }
  .diagram-grid {
    background-image: radial-gradient(rgb(21 23 28 / 0.09) 1px, transparent 1.2px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
  }
  .edge-base {
    fill: none;
    stroke: var(--color-line-strong);
    stroke-width: 2;
  }
  .edge-base.is-dashed {
    stroke-dasharray: 5 6;
  }
  .edge-flow {
    fill: none;
    stroke: var(--color-signal);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-dasharray: 10 14;
    opacity: 0;
    transition: opacity 0.4s ease;
  }
  .edge-packet {
    fill: var(--color-signal-deep);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .dedge.is-active .edge-flow,
  .dedge.is-active .edge-packet {
    opacity: 1;
  }
  .dedge.is-done .edge-base {
    stroke: color-mix(in oklab, var(--color-signal) 45%, var(--color-line-strong));
  }
  .dnode {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    width: max-content;
    max-width: 13.5rem;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    border-radius: 1rem;
    background: var(--color-card);
    border: 1.5px solid var(--color-line);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.3s,
      box-shadow 0.3s,
      opacity 0.3s;
    opacity: 0.72;
  }
  .dicon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    flex-shrink: 0;
    border-radius: 0.7rem;
    background: var(--color-paper-2);
    color: var(--color-ink-2);
    transition:
      background-color 0.3s,
      color 0.3s;
  }
  .dtext {
    display: grid;
    line-height: 1.2;
    min-width: 0;
  }
  .dlabel {
    font-family: var(--font-display);
    font-weight: 650;
    font-size: 0.86rem;
    color: var(--color-ink);
  }
  .dstatus {
    font-size: 0.74rem;
    color: var(--color-ink-3);
    min-height: 1em;
  }
  .dnode.is-done {
    opacity: 1;
  }
  .dnode.is-active {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.07);
    border-color: var(--color-ink);
    box-shadow:
      0 0 0 5px rgb(236 91 42 / 0.16),
      var(--shadow-lift);
    z-index: 2;
  }
  .dnode.is-active .dstatus {
    color: var(--color-signal-deep);
    font-weight: 600;
  }
  .dnode.tone-ai:is(.is-active, .is-done) .dicon {
    background: var(--color-signal);
    color: var(--color-ink);
  }
  .dnode.tone-you:is(.is-active, .is-done) .dicon {
    background: var(--color-moss);
    color: var(--color-paper);
  }
  .dnode.tone-us:is(.is-active, .is-done) .dicon {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  .dnode.tone-customer:is(.is-active, .is-done) .dicon {
    background: var(--color-paper-3);
    color: var(--color-ink);
  }
  .dnode.tone-tool:is(.is-active, .is-done) .dicon {
    background: var(--color-moss-soft);
    color: var(--color-moss);
  }
  .dstatus.is-changed {
    animation: status-in 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes status-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .dedge.is-active .edge-flow {
      animation: flow 0.9s linear infinite;
    }
    .dnode.is-active::after {
      content: '';
      position: absolute;
      inset: -6px;
      border-radius: 1.3rem;
      border: 2px solid var(--color-signal);
      animation: node-ping 1.6s ease-out infinite;
      pointer-events: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .edge-packet {
      display: none;
    }
  }
  @keyframes flow {
    to {
      stroke-dashoffset: -24;
    }
  }
  @keyframes node-ping {
    from {
      opacity: 0.7;
      transform: scale(0.98);
    }
    to {
      opacity: 0;
      transform: scale(1.12);
    }
  }

  /* ---------- tabs & panels ---------- */
  .process.is-enhanced .process-panel:not(.is-active) {
    display: none;
  }
  .process.is-enhanced .process-panel {
    border-top: 0;
  }
  .process.is-enhanced .process-panel.is-active {
    animation: panel-in 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .process-fill {
    transform: scaleX(calc(var(--active, 0) / max(1, calc(var(--steps) - 1))));
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .process-signal {
    position: absolute;
    top: 50%;
    left: calc(var(--active, 0) / max(1, calc(var(--steps) - 1)) * 100%);
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 999px;
    background: var(--color-signal);
    box-shadow: 0 0 0 6px rgb(236 91 42 / 0.2);
    transition: left 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .process-tab[aria-selected='true'] .process-node {
    border-color: var(--color-ink);
    background: var(--color-ink);
    color: var(--color-paper);
    transform: scale(1.12);
  }
  .process-tab.is-done .process-node {
    border-color: var(--color-signal);
    color: var(--color-signal-deep);
  }
  .process-tab:hover .process-node {
    border-color: var(--color-ink);
  }
  /* countdown ring on the active step while auto-playing */
  @property --p {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  .tab-timer {
    position: absolute;
    inset: -6px;
    border-radius: 999px;
    pointer-events: none;
    opacity: 0;
  }
  .process.is-playing .process-tab[aria-selected='true'] .tab-timer {
    opacity: 1;
    background: conic-gradient(var(--color-signal) calc(var(--p) * 1turn), transparent 0);
    mask: radial-gradient(farthest-side, transparent calc(100% - 3px), #000 calc(100% - 2.5px));
    animation: tab-timer var(--dur, 4600ms) linear forwards;
  }
  @keyframes tab-timer {
    to {
      --p: 1;
    }
  }
  .autoplay-pill {
    display: none;
  }
  .process.is-enhanced .autoplay-pill {
    display: inline-flex;
  }
  .process:not(.is-playing) .live-dot {
    background: var(--color-ink-3);
  }
  @media (prefers-reduced-motion: no-preference) {
    .process.is-playing .live-dot {
      animation: blink 1.2s ease-in-out infinite;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  .process-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--color-line-strong);
    transition:
      background-color 0.15s,
      box-shadow 0.15s;
  }
  .process-btn:hover {
    box-shadow: inset 0 0 0 1.5px var(--color-ink);
    background: var(--color-paper);
  }
  .preview-bubble {
    max-width: 92%;
    padding: 0.7rem 0.9rem;
    border-radius: 1rem;
    line-height: 1.45;
    font-size: 0.95rem;
    box-shadow: 0 1px 0 rgb(21 23 28 / 0.08);
  }
  .preview-bubble.is-in {
    background: var(--color-card);
    border-top-left-radius: 0.3rem;
  }
  .preview-bubble.is-out {
    margin-left: auto;
    background: #d9f2cf;
    border-top-right-radius: 0.3rem;
  }
</style>

<script>
  const STEP_MS = 4600; // time on each step while auto-playing
  const RESUME_MS = 9000; // after a manual click, auto-play resumes after this idle time

  document.querySelectorAll<HTMLElement>('[data-process]').forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    const pillLabel = root.querySelector<HTMLElement>('[data-autoplay-label]');
    const nodes = [...root.querySelectorAll<HTMLElement>('[data-node]')];
    const edges = [...root.querySelectorAll<SVGGElement>('[data-edge]')];
    const scroller = root.querySelector<HTMLElement>('[data-diagram-scroll]');
    const stepsOf = (el: Element) => (el.getAttribute('data-steps') || '').split(',').filter(Boolean).map(Number);

    root.classList.add('is-enhanced');
    root.style.setProperty('--dur', `${STEP_MS}ms`);
    root.querySelector<HTMLElement>('[data-rail]')!.hidden = false;
    root.querySelector<HTMLElement>('[data-controls]')!.hidden = false;
    root.querySelector('[data-panels]')!.setAttribute('role', 'presentation');
    panels.forEach((p) => {
      p.setAttribute('role', 'tabpanel');
      p.setAttribute('aria-labelledby', p.dataset.labelledby!);
      p.tabIndex = 0;
    });

    let active = 0;
    const stopped = false; // no pause control: loops continuously
    let visible = false;
    let timer: number | undefined;
    let resumeTimer: number | undefined;

    // Eased horizontal pan (rAF), so it works everywhere and respects reduced motion.
    let panFrame = 0;
    const panTo = (target: number) => {
      if (!scroller) return;
      const max = scroller.scrollWidth - scroller.clientWidth;
      const to = Math.max(0, Math.min(max, target));
      const from = scroller.scrollLeft;
      cancelAnimationFrame(panFrame);
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        scroller.scrollLeft = to;
        return;
      }
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / 700);
        const e = 1 - Math.pow(1 - t, 4);
        scroller.scrollLeft = from + (to - from) * e;
        if (t < 1) panFrame = requestAnimationFrame(step);
      };
      panFrame = requestAnimationFrame(step);
    };

    const paintDiagram = () => {
      const activeNodes: HTMLElement[] = [];
      nodes.forEach((n) => {
        const s = stepsOf(n);
        const on = s.includes(active);
        n.classList.toggle('is-active', on);
        n.classList.toggle('is-done', !on && s.some((x) => x < active));
        if (on) activeNodes.push(n);
        const timeline: string[] = JSON.parse(n.dataset.status || '[]');
        const el = n.querySelector<HTMLElement>('[data-status-text]');
        const next = timeline[active] ?? '';
        if (el && el.textContent !== next) {
          el.textContent = next;
          el.classList.remove('is-changed');
          void el.offsetWidth;
          el.classList.add('is-changed');
        }
      });
      edges.forEach((e) => {
        const s = stepsOf(e);
        e.classList.toggle('is-active', s.includes(active));
        e.classList.toggle('is-done', !s.includes(active) && s.some((x) => x < active));
      });
      // On narrow screens, pan the diagram to follow the action.
      if (visible && scroller && scroller.scrollWidth > scroller.clientWidth + 4 && activeNodes.length) {
        const box = scroller.getBoundingClientRect();
        const xs = activeNodes.map((n) => {
          const r = n.getBoundingClientRect();
          return r.left + r.width / 2 - box.left + scroller.scrollLeft;
        });
        const mid = (Math.min(...xs) + Math.max(...xs)) / 2;
        panTo(mid - scroller.clientWidth / 2);
      }
    };

    const playing = () => !stopped && visible && resumeTimer === undefined;
    const schedule = () => {
      window.clearTimeout(timer);
      const on = playing();
      root.classList.toggle('is-playing', on);
      if (pillLabel) pillLabel.textContent = stopped ? 'Paused' : on ? 'Auto-playing' : 'Resuming soon';
      if (on) timer = window.setTimeout(() => select(active + 1), STEP_MS);
    };

    function select(i: number, focus = false) {
      active = (i + tabs.length) % tabs.length;
      root.style.setProperty('--active', String(active));
      tabs.forEach((t, n) => {
        const on = n === active;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('is-done', n < active);
        const ring = t.querySelector<HTMLElement>('.tab-timer');
        if (ring && on) {
          ring.style.animation = 'none';
          void ring.offsetWidth;
          ring.style.animation = '';
        }
      });
      panels.forEach((p, n) => p.classList.toggle('is-active', n === active));
      paintDiagram();
      if (focus) tabs[active]!.focus();
      schedule();
    }

    // A manual interaction pauses briefly; auto-play then resumes on its own.
    const nudge = () => {
      window.clearTimeout(resumeTimer);
      resumeTimer = window.setTimeout(() => {
        resumeTimer = undefined;
        schedule();
      }, RESUME_MS);
      schedule();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => {
        select(i);
        nudge();
      });
      t.addEventListener('keydown', (e) => {
        const map: Record<string, number> = { ArrowRight: active + 1, ArrowDown: active + 1, ArrowLeft: active - 1, ArrowUp: active - 1, Home: 0, End: tabs.length - 1 };
        if (e.key in map) {
          e.preventDefault();
          select(map[e.key]!, true);
          nudge();
        }
      });
    });
    root.querySelector('[data-prev]')!.addEventListener('click', () => {
      select(active - 1);
      nudge();
    });
    root.querySelector('[data-next]')!.addEventListener('click', () => {
      select(active + 1);
      nudge();
    });

    new IntersectionObserver(
      ([entry]) => {
        const was = visible;
        visible = !!entry?.isIntersecting;
        if (visible && !was) paintDiagram();
        schedule();
      },
      { threshold: 0.2 },
    ).observe(root);

    select(0);
  });
</script>
