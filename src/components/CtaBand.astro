---
import CtaButtons from './CtaButtons.astro';
interface Props {
  title?: string;
  text?: string;
  whatsappMessage?: string;
}
const {
  title = 'Not sure where to start? Book a free 30-minute AI audit.',
  text = 'We look at how enquiries, bookings and admin work in your business today and tell you, plainly, what is worth automating and what is not. No obligation.',
  whatsappMessage,
} = Astro.props;
---

<section aria-labelledby="cta-band-title" class="container-x py-16 sm:py-24">
  <div class="on-dark grain relative overflow-hidden rounded-[2rem] bg-ink px-6 py-14 text-paper sm:px-12 sm:py-16 lg:px-16">
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 -top-24 size-80 rounded-full bg-signal/30 blur-3xl"></div>
    <div aria-hidden="true" class="pointer-events-none absolute -bottom-32 left-1/3 size-80 rounded-full bg-moss/60 blur-3xl"></div>
    <div class="relative grid gap-8 lg:grid-cols-[1.4fr_1fr] lg:items-end">
      <div>
        <p class="eyebrow !text-paper/60">Next step</p>
        <h2 id="cta-band-title" class="mt-3 text-h2 text-paper">{title}</h2>
        <p class="mt-5 max-w-2xl text-lead text-paper/80">{text}</p>
      </div>
      <CtaButtons whatsappMessage={whatsappMessage} class="lg:flex-col lg:items-stretch [&_.btn-ghost]:text-paper [&_.btn-ghost]:decoration-paper/40" />
    </div>
  </div>
</section>
