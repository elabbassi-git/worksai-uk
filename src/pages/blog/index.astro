---
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CtaBand from '@/components/CtaBand.astro';
import PostCards from '@/components/PostCards.astro';
import { publishedPosts, postPath } from '@/lib/content';
import { fillPrices } from '@/data/pricing';

const posts = await publishedPosts();
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const categories = ['Pricing guides', 'How-to', 'Comparisons'] as const;
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
const schema = [
  {
    '@type': 'Blog',
    name: 'Works AI blog',
    url: 'https://worksai.uk/blog/',
    inLanguage: 'en-GB',
    blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.h1, url: `https://worksai.uk${postPath(p)}`, datePublished: p.data.published.toISOString().slice(0, 10) })),
  },
];
---

<BaseLayout
  title="Blog: SaaS, AI and Website Guides UK | Works AI"
  description="In-depth guides for UK businesses on custom SaaS development, AI receptionists, AI automation, one-time pricing and what software really costs. By Works AI."
  path="/blog/"
  breadcrumbs={[{ name: 'Blog', path: '/blog/' }]}
  schema={schema}
>
  <PageHero eyebrow="Blog" title="Guides for UK businesses building with software and AI" intro="Practical, in-depth answers on building SaaS platforms, using AI to answer and automate, and what it all really costs. No hype, no invented numbers."></PageHero>

  {
    featured && (
      <section class="container-x pb-12" aria-label="Featured guide">
        <a href={postPath(featured)} class="group on-dark grain relative grid overflow-hidden rounded-[2rem] bg-ink p-7 text-paper transition-transform duration-300 hover:-translate-y-1 sm:p-10 lg:grid-cols-[1.4fr_1fr] lg:gap-12">
          <div aria-hidden="true" class="pointer-events-none absolute -right-20 -top-24 size-96 rounded-full bg-signal/30 blur-3xl transition-transform duration-700 group-hover:scale-110" />
          <div class="relative">
            <p class="eyebrow !text-paper/65">Featured · {featured.data.category} · {featured.data.readingTime} read</p>
            <h2 class="mt-4 text-h2 text-paper">{featured.data.h1}</h2>
            <p class="mt-4 max-w-2xl text-lead text-paper/80">{fillPrices(featured.data.answer)}</p>
            <span class="mt-7 inline-flex items-center gap-2 font-semibold text-paper underline decoration-signal underline-offset-4">Read the guide</span>
          </div>
          <ol class="relative mt-8 grid content-center gap-3 lg:mt-0">
            {featured.data.takeaways.slice(0, 3).map((t, i) => (
              <li class="flex gap-3 rounded-2xl bg-paper/10 p-4">
                <span class="grid size-7 shrink-0 place-items-center rounded-full bg-signal font-mono text-xs text-ink">{i + 1}</span>
                <span class="text-paper/90">{t}</span>
              </li>
            ))}
          </ol>
        </a>
      </section>
    )
  }

  <section class="container-x pb-16" aria-labelledby="all-guides">
    <div class="flex flex-col gap-5 border-t border-line pt-10 md:flex-row md:items-end md:justify-between">
      <h2 id="all-guides" class="text-h2">All guides</h2>
      <div class="flex flex-wrap gap-2" role="group" aria-label="Filter by category" data-blog-filters hidden>
        <button type="button" class="chip is-on" data-filter="all" aria-pressed="true">All <span>{posts.length}</span></button>
        {
          categories.map((c) => (
            <button type="button" class="chip" data-filter={c} aria-pressed="false">
              {c} <span>{count(c)}</span>
            </button>
          ))
        }
      </div>
    </div>
    <div class="mt-8" data-blog-list>
      <PostCards posts={[featured!, ...rest]} />
    </div>
    <p class="mt-6 text-ink-3" data-blog-empty hidden>No guides in this category yet.</p>
  </section>

  <section class="container-x pb-8">
    <div class="grid gap-5 rounded-[2rem] border border-line bg-card p-7 sm:p-10 md:grid-cols-3">
      <div class="md:col-span-1">
        <p class="eyebrow">More reading</p>
        <h2 class="mt-3 font-display text-h3 font-semibold">Guides for smaller businesses</h2>
      </div>
      <ul class="grid gap-2 md:col-span-2 sm:grid-cols-2">
        {
          [
            ['/get-found-on-google/', 'How to get your business on Google'],
            ['/seo-for-small-business/', 'SEO for small businesses, without the jargon'],
            ['/small-business-website/', 'What a small business website needs'],
            ['/website-redesign/', 'Fix or rebuild an old, slow website'],
          ].map(([h, t]) => (
            <li><a href={h} class="flex min-h-12 items-center justify-between gap-3 rounded-xl border border-line bg-paper px-4 font-semibold transition-colors hover:border-ink">{t}<span aria-hidden="true">→</span></a></li>
          ))
        }
      </ul>
    </div>
  </section>
  <CtaBand />
</BaseLayout>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 999px;
    border: 1.5px solid var(--color-line-strong);
    background: var(--color-card);
    font-weight: 600;
    font-size: 0.95rem;
    transition:
      background-color 0.2s,
      color 0.2s,
      border-color 0.2s,
      transform 0.15s;
  }
  .chip span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--color-paper-2);
    color: var(--color-ink-2);
  }
  .chip:hover {
    border-color: var(--color-ink);
  }
  .chip:active {
    transform: scale(0.97);
  }
  .chip.is-on {
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }
  .chip.is-on span {
    background: var(--color-signal);
    color: var(--color-ink);
  }
  :global(.post-card.is-hidden) {
    display: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.post-card.is-in) {
      animation: card-in 0.45s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }
  }
  @keyframes card-in {
    from {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-blog-filters]');
  if (bar) {
    bar.hidden = false;
    const chips = [...bar.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-blog-list] [data-category]')];
    const empty = document.querySelector<HTMLElement>('[data-blog-empty]')!;
    bar.addEventListener('click', (e) => {
      const chip = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
      if (!chip) return;
      const f = chip.dataset.filter!;
      chips.forEach((c) => {
        const on = c === chip;
        c.classList.toggle('is-on', on);
        c.setAttribute('aria-pressed', String(on));
      });
      let shown = 0;
      cards.forEach((card) => {
        const match = f === 'all' || card.dataset.category === f;
        card.classList.toggle('is-hidden', !match);
        card.classList.remove('is-in');
        if (match) {
          void card.offsetWidth;
          card.classList.add('is-in');
          shown++;
        }
      });
      empty.hidden = shown > 0;
    });
  }
</script>
