---
import PageHero from '@/components/PageHero.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/Section.astro';
import CtaBand from '@/components/CtaBand.astro';
import DataHandling from '@/components/DataHandling.astro';
import HowWeWork from '@/components/HowWeWork.astro';
import { site, isSet } from '@/config/site';
---

<BaseLayout
  title="About Works AI: Remote AI and Web Agency | Works AI"
  description="Who we are and how our remote team works with UK businesses on UK hours: plain English, fixed prices and honest advice. Book a free 30-minute AI audit."
  path="/about/"
  breadcrumbs={[{ name: 'About', path: '/about/' }]}
  schema={[{ '@type': 'AboutPage', name: 'About Works AI', url: 'https://worksai.uk/about/' }]}
>
  <PageHero eyebrow="About us" title="A remote AI and web agency, built for UK small businesses" intro="Works AI builds websites, AI assistants and automations for UK businesses that want more enquiries and less admin. We are a remote team, and we work UK business hours (GMT/BST)."></PageHero>

  <Section id="who" eyebrow="Who we are" title="The people behind Works AI" tone="alt">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div class="grid aspect-[4/5] place-items-center rounded-[var(--radius-card)] border border-dashed border-line-strong bg-card p-6 text-center text-ink-3">
        <p>{'{{TEAM_PHOTOS}}'}<span class="mt-2 block text-sm">Real team photos go here, with explicit width and height via Astro's Image component.</span></p>
      </div>
      <div class="prose prose-lg prose-works">
        <h3>Founder</h3>
        <p>{'{{FOUNDER_BIO}}'}</p>
        {isSet(site.linkedinUrl) ? <p><a href={site.linkedinUrl} rel="noopener">Works AI on LinkedIn</a></p> : <p>{site.linkedinUrl}</p>}
      </div>
    </div>
  </Section>

  <Section id="how" eyebrow="How we work" title="How a remote team works with UK clients">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        [
          ['UK hours', `We are available ${site.hours}. Calls, replies and launches happen in your working day.`],
          ['Video, email and WhatsApp', 'Most of our clients never need to meet in person. We use video calls for workshops and reviews, and WhatsApp or email for quick questions.'],
          ['Plain UK English', 'Everything we write for you, from website copy to assistant replies, is in UK English, with UK spelling, dates and prices in pounds.'],
          ['Fixed prices', 'You get a written proposal with a fixed price before we start. Our prices are published, so you can compare.'],
        ].map(([t, d]) => (
          <div class="card p-6">
            <h3 class="font-display text-h3 font-semibold">{t}</h3>
            <p class="mt-2 text-ink-2">{d}</p>
          </div>
        ))
      }
    </div>
    <div class="prose prose-lg prose-works prose-cols mt-12">
      <h3>Why we work remotely</h3>
      <p>
        We don't have a high-street office, and we don't pretend to. Working remotely is how we keep our <a href="/pricing/">prices</a> fair, and it doesn't change how you work with us: you get a named contact, quick replies in UK hours and work written for UK customers.
      </p>
      <h3>What we believe</h3>
      <ul>
        <li>AI should take boring work off people, not replace the human touch your customers value.</li>
        <li>Customers should always know when they are talking to an AI, and be able to reach a person.</li>
        <li>Small businesses deserve straight answers and published prices.</li>
      </ul>
      <p>See what we do in <a href="/services/">AI services</a> and <a href="/business/">business solutions</a>.</p>
    </div>
  </Section>

  <Section id="what" eyebrow="What we build" title="A product studio for UK businesses" tone="alt">
    <ul class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {
        [
          ['/services/saas-development/', 'SaaS platforms', 'Multi-tenant products, customer portals and internal platforms, built to production standard.'],
          ['/services/ai-web-development/', 'AI web apps', 'Search, document reading and assistants inside your product, with safeguards.'],
          ['/services/ai-agents/', 'AI agents', 'Assistants that answer, book and log enquiries on WhatsApp, the web and the phone.'],
          ['/business/website-design-seo/', 'Websites', 'Fast sites with SEO built in and an AI chat assistant.'],
        ].map(([h, t, d]) => (
          <li>
            <a href={h} class="card card-link flex h-full flex-col p-6">
              <h3 class="font-display text-h3 font-semibold">{t}</h3>
              <p class="mt-2 flex-1 text-ink-2">{d}</p>
              <span class="link mt-4 text-sm font-semibold">Explore {t.toLowerCase()}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <HowWeWork title="How we work with every client" />
  </Section>

  <Section id="company" eyebrow="Company details" title="Legal information">
    <dl class="grid gap-px overflow-hidden rounded-[var(--radius-card)] border border-line bg-line sm:grid-cols-2">
      {isSet(site.legalName) && <div class="bg-card p-6"><dt class="eyebrow">Legal name</dt><dd class="mt-1 text-lg">{site.legalName}</dd></div>}
      {isSet(site.registrationNumber) && <div class="bg-card p-6"><dt class="eyebrow">Company registration number</dt><dd class="mt-1 text-lg">{site.registrationNumber}</dd></div>}
      <div class="bg-card p-6"><dt class="eyebrow">Trading name</dt><dd class="mt-1 text-lg">{site.brand}</dd></div>
      <div class="bg-card p-6"><dt class="eyebrow">Contact</dt><dd class="mt-1 text-lg"><a href="/contact/" class="link">Contact page</a> · {site.email}</dd></div>
    </dl>
    <div class="mt-10"><DataHandling /></div>
  </Section>

  <CtaBand />
</BaseLayout>
